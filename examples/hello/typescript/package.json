{
  "name": "hello",
  "private": true,
  "description": "HelloService's TypeScript server and client, generated by beadc from ../proto.",
  "type": "module",
  "imports": {
    "#hello": {
      "external": "./gen/external/hello/v1/hello_bead.ts",
      "default": "./gen/generate/hello/v1/hello_bead.ts"
    },
    "#hello/http": {
      "external": "./gen/external/bead_http.ts",
      "default": "./gen/generate/bead_http.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --preserve-symlinks --platform=node --format=esm --target=node24 --external:ws --outfile=dist/generate/hello.mjs",
    "build:external": "yarn messages && esbuild src/main.ts --bundle --preserve-symlinks --platform=node --format=esm --target=node24 --external:ws --conditions=external --outfile=dist/external/hello.mjs",
    "check": "yarn messages && yarn type-check && yarn type-check:external && yarn type-check:consumer && yarn lint --deny-warnings && yarn format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "messages": "buf generate .. --template buf.gen.yaml",
    "type-check": "tsc --noEmit",
    "type-check:external": "tsc --noEmit --customConditions external",
    "type-check:consumer": "tsc --noEmit -p tsconfig.consumer.json && tsc --noEmit -p tsconfig.consumer.json --customConditions external"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@francisdesjardins/bead": "portal:../../../implementations/typescript",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "dependenciesMeta": {
    "@bufbuild/buf": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "engines": {
    "node": ">=24.9"
  },
  "packageManager": "yarn@4.18.1"
}
