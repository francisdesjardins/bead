{
  "components": {
    "schemas": {
      "Problem": {
        "description": "A failure, as RFC 9457 writes one (transcoding 7).",
        "properties": {
          "code": {
            "description": "The code, as the wire carries it.",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "protocol",
              "application"
            ]
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "description": "The code's name, or the status's phrase for about:blank.",
            "type": "string"
          },
          "type": {
            "description": "The problem's identity: a protocol code's tag: URI, an application failure's under the project's problem types, or about:blank.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "status",
          "title",
          "type"
        ],
        "type": "object"
      },
      "ValidationProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "properties": {
              "errors": {
                "items": {
                  "properties": {
                    "bounds": {},
                    "detail": {
                      "type": "string"
                    },
                    "fieldPath": {
                      "type": "string"
                    },
                    "forKey": {
                      "type": "boolean"
                    },
                    "parameter": {
                      "description": "Its field, bound by a variable or a parameter of the query.",
                      "type": "string"
                    },
                    "pointer": {
                      "description": "Its field in the body, RFC 6901 §6's fragment by JSON names.",
                      "type": "string"
                    },
                    "ruleId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail",
                    "ruleId"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "more": {
                "minimum": 1,
                "type": "integer"
              },
              "stopped": {
                "const": true
              }
            },
            "required": [
              "errors"
            ],
            "type": "object"
          }
        ],
        "description": "PAYLOAD_INVALID: the request its message's rules refused, each violation an error (decision 0035)."
      },
      "hello.v1.AskNameRequest": {
        "additionalProperties": false,
        "description": "hello.v1.AskNameRequest. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "question": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "hello.v1.AskNameResponse": {
        "additionalProperties": false,
        "description": "hello.v1.AskNameResponse. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "hello.v1.CountDownRequest": {
        "additionalProperties": false,
        "description": "hello.v1.CountDownRequest. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "from": {
            "allOf": [
              {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              },
              {
                "maximum": 10
              }
            ]
          }
        },
        "type": "object"
      },
      "hello.v1.CountDownResponse": {
        "additionalProperties": false,
        "description": "hello.v1.CountDownResponse. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "ticks": {
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "hello.v1.SayHelloRequest": {
        "additionalProperties": false,
        "description": "hello.v1.SayHelloRequest. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "hello.v1.SayHelloResponse": {
        "additionalProperties": false,
        "description": "hello.v1.SayHelloResponse. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "greeting": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "hello.v1.Tick": {
        "additionalProperties": false,
        "description": "hello.v1.Tick. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "remaining": {
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "credential": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Hello",
    "version": "Hello.2"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.1",
  "paths": {
    "/api/Hello/countDown": {
      "post": {
        "description": "Counts down from a number to 0, a Tick a step, for a caller its connection greeted.",
        "operationId": "Hello.countDown",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/hello.v1.CountDownRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/hello.v1.CountDownResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-bead-events": {
                  "failure": {
                    "$ref": "#/components/schemas/Problem"
                  },
                  "message": {
                    "$ref": "#/components/schemas/hello.v1.Tick"
                  },
                  "result": {
                    "$ref": "#/components/schemas/hello.v1.CountDownResponse"
                  }
                }
              }
            },
            "description": "The result; with Accept: text/event-stream, the result, then each notification, then the failure that ends them (transcoding 8)."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "SESSION_REQUIRED: a call its admission needs a credential for.",
            "headers": {
              "WWW-Authenticate": {
                "description": "The gateway's challenge (RFC 6750 §3).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "PAYLOAD_INVALID: its request's rules refused it."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A failure (transcoding 7)."
          }
        },
        "security": [
          {
            "credential": []
          }
        ],
        "summary": "Counts down from a number to 0, a Tick a step, for a caller its connection greeted.",
        "tags": [
          "Hello"
        ],
        "x-bead": {
          "procedure": "countDown",
          "procedureId": 2,
          "procedureKind": "notifies",
          "service": "Hello",
          "serviceId": 1
        }
      }
    },
    "/api/Hello/sayHello": {
      "post": {
        "description": "Greets a name; given none, asks its caller's first, by AskName.",
        "operationId": "Hello.sayHello",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/hello.v1.SayHelloRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/hello.v1.SayHelloResponse"
                }
              }
            },
            "description": "The result."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A failure (transcoding 7)."
          }
        },
        "security": [
          {},
          {
            "credential": []
          }
        ],
        "summary": "Greets a name; given none, asks its caller's first, by AskName.",
        "tags": [
          "Hello"
        ],
        "x-bead": {
          "procedure": "sayHello",
          "procedureId": 1,
          "procedureKind": "request",
          "service": "Hello",
          "serviceId": 1
        }
      }
    }
  },
  "tags": [
    {
      "description": "Greets its callers, asks a nameless one its name, and counts down for one it greeted.",
      "name": "Hello"
    }
  ]
}
