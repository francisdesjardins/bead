<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org alone, whatever the machine's own configuration adds: every package comes from where CI
  takes it, as the TypeScript side's come from one registry and one lockfile (0005).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
