#!/bin/sh
# Before each commit, the root's staged files in their format (tools/check-format.mjs, when the
# TypeScript side is installed), then the checks this clone keeps for itself in .claude/local/,
# when it has them.
# Opt in once per clone: git config core.hooksPath .githooks
set -e
node tools/check-format.mjs --staged
if [ -f .claude/local/check.mjs ]; then
  exec node .claude/local/check.mjs
fi
