# Text is stored and checked out with LF on every machine: the spec's generators write LF, and the
# conformance files are compared byte for byte.
* text=auto eol=lf

# The vendored Yarn releases run as they were released: no normalisation may touch them.
/implementations/typescript/.yarn/releases/** binary
/builder/.yarn/releases/** binary
/examples/hello/typescript/.yarn/releases/** binary
/site/.yarn/releases/** binary

# Binary by nature, should one ever be committed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
*.snk binary

# A descriptor set, protobuf's own binary, as a test or a golden of beadc holds one.
*.binpb binary

# What beadc writes for a Rust output, held by `generate --check`: shown as generated, its diff
# folded.
/examples/hello/rust/src/generated/** linguist-generated
/implementations/rust/crates/bead-interop/src/generated/** linguist-generated
