{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's interop service, spec/interop-service.json",
  "type": "object",
  "required": ["$comment", "specVersion", "serviceId", "serviceRevision", "procedures"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "schemas/interop-service.schema.json" },
    "$comment": { "$ref": "common.schema.json#/$defs/comment" },
    "specVersion": { "$ref": "common.schema.json#/$defs/specVersion" },
    "serviceId": { "$ref": "common.schema.json#/$defs/u16" },
    "serviceRevision": { "type": "integer", "minimum": 1 },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A procedure, what it takes, what it answers, and what admits or notifies, when it does.",
        "type": "object",
        "required": ["procedureId", "procedureName", "request", "answers"],
        "additionalProperties": false,
        "properties": {
          "procedureId": { "$ref": "common.schema.json#/$defs/u16" },
          "procedureName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "request": { "type": "string", "minLength": 1 },
          "answers": { "type": "string", "minLength": 1 },
          "admits": { "type": "string", "minLength": 1 },
          "notifies": { "type": "string", "minLength": 1 },
          "offeredBy": {
            "description": "client, for a command, which a client offers and its server calls.",
            "const": "client"
          }
        }
      }
    }
  }
}
