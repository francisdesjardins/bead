{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's interop service, spec/interop-service.json",
  "type": "object",
  "required": ["$comment", "specVersion", "serviceId", "serviceRevision", "procedures"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "schemas/interop-service.schema.json"
    },
    "$comment": {
      "$ref": "common.schema.json#/$defs/comment"
    },
    "specVersion": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "serviceId": {
      "$ref": "common.schema.json#/$defs/serviceId"
    },
    "serviceRevision": {
      "$ref": "common.schema.json#/$defs/serviceRevision"
    },
    "relay": {
      "description": "What the interop server's relay admits, what it forwards, and whether it verifies what it forwards.",
      "type": "object",
      "required": ["admits", "forwards", "verifies"],
      "additionalProperties": false,
      "properties": {
        "admits": {
          "type": "string",
          "minLength": 1
        },
        "forwards": {
          "type": "string",
          "minLength": 1
        },
        "verifies": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A procedure, what it takes, what it answers, and what admits or notifies, when it does.",
        "type": "object",
        "required": ["procedureId", "procedureName", "request", "answers"],
        "additionalProperties": false,
        "properties": {
          "procedureId": {
            "$ref": "common.schema.json#/$defs/procedureId"
          },
          "procedureName": {
            "$ref": "common.schema.json#/$defs/procedureName"
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "answers": {
            "type": "string",
            "minLength": 1
          },
          "admits": {
            "type": "string",
            "minLength": 1
          },
          "notifies": {
            "type": "string",
            "minLength": 1
          },
          "offeredBy": {
            "description": "client, for a command, which a client offers and its server calls.",
            "const": "client"
          }
        }
      }
    },
    "credentials": {
      "description": "What the interop server verifies a credential with, by its credential scheme.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jwt": {
          "description": "A JWT's keys, its audience and its key set (spec 13.8).",
          "type": "object",
          "required": ["keys", "audience", "keySet"],
          "additionalProperties": false,
          "properties": {
            "keys": {
              "description": "The server's keys, each a JWK (RFC 7517) with its issuer and its one algorithm.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["issuer", "algorithm", "jwk"],
                "additionalProperties": false,
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "algorithm": {
                    "$ref": "#/$defs/jwtAlgorithm"
                  },
                  "jwk": {
                    "$ref": "#/$defs/jwk"
                  }
                }
              }
            },
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "keySet": {
              "description": "The key set the server is given, with the issuers it answers for (spec 13.8): each issuer, the keys it answers, each a JWK with its one algorithm, and what and when it answers; the most calls that wait for one issuer's deadline at once; and what it does asked for any other issuer.",
              "type": "object",
              "required": ["issuers", "maximumWaitingCalls", "answers"],
              "additionalProperties": false,
              "properties": {
                "issuers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["issuer", "keys", "answers"],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "keys": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["algorithm", "jwk"],
                          "additionalProperties": false,
                          "properties": {
                            "algorithm": {
                              "$ref": "#/$defs/jwtAlgorithm"
                            },
                            "jwk": {
                              "$ref": "#/$defs/jwk"
                            }
                          }
                        }
                      },
                      "answers": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "maximumWaitingCalls": {
                  "description": "The most calls that wait for one issuer's deadline at once, a call on its ask under way never counted (spec 13.8).",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "answers": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "elsewhere": {
          "description": "Its ELSEWHERE verifier: what it reads, the grammar of the values it holds, in ABNF, one rule a line, and what it settles with.",
          "type": "object",
          "required": ["reads", "grammar", "settles"],
          "additionalProperties": false,
          "properties": {
            "reads": {
              "type": "string",
              "minLength": 1
            },
            "grammar": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z-]* += \\S"
              }
            },
            "settles": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "jwtAlgorithm": {
      "description": "A JWT key's one algorithm (RFC 8725 §3.1).",
      "enum": ["ES256", "HS256"]
    },
    "jwk": {
      "description": "A JSON Web Key (RFC 7517), its public half alone but an HMAC key's.",
      "type": "object",
      "required": ["kty"],
      "not": {
        "required": ["d"]
      }
    }
  }
}
