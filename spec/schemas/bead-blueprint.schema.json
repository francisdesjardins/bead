{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A blueprint of Bead's builder, bead-blueprint/1: the services a .proto declares, resolved, in the runtime's words (decision 0022)",
  "description": "What one entry holds, in no language's words: no file option, no class, no path of a target's. What spans entries — one id and one name a scope, folded as spec 16.6 folds; the reservations; a failure its service lacks; a proto binding whose message proto does not list — is beadc check's, by rule name. A reader refuses a format it does not know, and a feature of requires it does not know.",
  "type": "object",
  "required": ["format", "specVersion", "requires", "reservedServices", "services"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "description": "The format and its major: a reader refuses another.",
      "const": "bead-blueprint/1"
    },
    "specVersion": {
      "description": "The version of spec/spec.md whose sections 16 and 17 its producer follows.",
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "requires": {
      "description": "The features it uses beyond the base, each by its name, as JOSE's crit lists them (RFC 7515 §4.1.11): a reader refuses one it does not know, and names it.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
      }
    },
    "proto": {
      "description": "What a front end read from a .proto, when it read one: the files that declare a service or a message a binding names, and those messages. Absent from a blueprint written by hand, whose bindings are all native.",
      "type": "object",
      "required": ["files", "messages"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "The .proto files that declare one of its services or one of its messages, by path.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "messages": {
          "description": "The messages a binding names, every message a field of one reaches, and under the feature validate those a request's rules reach, by full name, each with the file that declares it: what a target imports, each message's fields, which a route binds and a document describes, and under validate the fields that hold a rule or lead to one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "enums": {
          "description": "The enums the fields of its messages name, by full name: each value by its name and number, in their declaration's order, an alias among them, so that a writer names a number by the value declared first for it (decision 0037). A well-known enum, google.protobuf.NullValue, is named by its full name alone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/enum"
          }
        }
      }
    },
    "reservedServices": {
      "description": "The service ids and names its files' packages retired, which none of its services takes.",
      "type": "object",
      "required": ["ids", "names"],
      "additionalProperties": false,
      "properties": {
        "ids": {
          "$ref": "#/$defs/ranges"
        },
        "names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/serviceName"
          }
        }
      }
    },
    "services": {
      "description": "Its services, by id: one blueprint is one id space.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "if": {
    "description": "A message that carries its rules requires the feature validate (decision 0035), as JOSE's crit names a member a reader must know.",
    "type": "object",
    "required": ["proto"],
    "properties": {
      "proto": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["rules"]
            }
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "requires": {
        "type": "array",
        "contains": {
          "const": "validate"
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "package"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Its path from its root, as an import names it, parts by /.",
          "$ref": "#/$defs/protoPath"
        },
        "package": {
          "description": "Its protobuf package; empty for none.",
          "type": "string",
          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?(?![\\s\\S])"
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["fullName", "file"],
      "additionalProperties": false,
      "properties": {
        "fullName": {
          "$ref": "#/$defs/fullName"
        },
        "file": {
          "description": "The path, among its files, of the file that declares it.",
          "$ref": "#/$defs/protoPath"
        },
        "fields": {
          "description": "Its fields, by number; left out of a well-known type, and of a blueprint an earlier beadc wrote.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "rules": {
          "$ref": "#/$defs/messageRules"
        }
      },
      "description": "A message: its fields, each by its name, number, JSON name and type, which a route binds and a document describes (decision 0037), and under the feature validate its rules (decision 0035). A well-known type of google/protobuf/, whose JSON is its own form, carries no fields."
    },
    "service": {
      "type": "object",
      "required": [
        "serviceName",
        "serviceId",
        "serviceRevision",
        "failures",
        "reserved",
        "procedures"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceName": {
          "description": "What its classes and routes are named after: its .proto name, a trailing Service taken off.",
          "$ref": "#/$defs/serviceName"
        },
        "serviceId": {
          "$ref": "common.schema.json#/$defs/serviceId"
        },
        "serviceRevision": {
          "$ref": "common.schema.json#/$defs/serviceRevision"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        },
        "failures": {
          "description": "Its catalogue (spec 9.5), by code: what its procedures answer, each by its name.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "failureName"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "common.schema.json#/$defs/code"
              },
              "failureName": {
                "$ref": "#/$defs/failureName"
              },
              "description": {
                "$ref": "#/$defs/description"
              },
              "deprecation": {
                "$ref": "#/$defs/deprecation"
              }
            }
          }
        },
        "reserved": {
          "description": "The procedure ids and names, and the failure codes, it retired, which none of its procedures and failures takes.",
          "type": "object",
          "required": ["procedureIds", "procedureNames", "failureCodes"],
          "additionalProperties": false,
          "properties": {
            "procedureIds": {
              "$ref": "#/$defs/ranges"
            },
            "procedureNames": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/procedureName"
              }
            },
            "failureCodes": {
              "$ref": "#/$defs/ranges"
            }
          }
        },
        "procedures": {
          "description": "Its procedures, by id.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/procedure"
          }
        },
        "proto": {
          "description": "Where a front end read it: its file's path, among proto's files, and its full name.",
          "type": "object",
          "required": ["file", "fullName"],
          "additionalProperties": false,
          "properties": {
            "file": {
              "description": "The path, among its files, of the file that declares it.",
              "$ref": "#/$defs/protoPath"
            },
            "fullName": {
              "$ref": "#/$defs/fullName"
            }
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "required": [
        "procedureId",
        "procedureName",
        "procedureKind",
        "request",
        "result",
        "admission",
        "failures"
      ],
      "additionalProperties": false,
      "properties": {
        "procedureId": {
          "$ref": "common.schema.json#/$defs/procedureId"
        },
        "procedureName": {
          "$ref": "common.schema.json#/$defs/procedureName"
        },
        "procedureKind": {
          "description": "How it is called (spec 16.11): never its envelopes' kind.",
          "enum": ["request", "notifies", "command"]
        },
        "request": {
          "$ref": "#/$defs/binding"
        },
        "result": {
          "$ref": "#/$defs/binding"
        },
        "notification": {
          "$ref": "#/$defs/binding"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        },
        "failures": {
          "description": "The names of its service's catalogue it may answer, in their codes' order.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failureName"
          }
        },
        "maximumPayloadBytes": {
          "description": "The most bytes a payload of it holds, its request's and its result's; left out, the router's alone.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "http": {
          "$ref": "#/$defs/http"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        }
      },
      "if": {
        "properties": {
          "procedureKind": {
            "const": "notifies"
          }
        }
      },
      "then": {
        "required": ["notification"]
      },
      "else": {
        "not": {
          "required": ["notification"]
        }
      }
    },
    "binding": {
      "description": "A payload's encoding (spec 17), and for proto alone its message: raw, text and json are bead.Raw's, bead.Text's and bead.Json's, which the blueprint does not repeat.",
      "type": "object",
      "required": ["encoding"],
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "enum": ["raw", "text", "json", "proto"]
        },
        "message": {
          "$ref": "#/$defs/fullName"
        }
      },
      "if": {
        "properties": {
          "encoding": {
            "const": "proto"
          }
        }
      },
      "then": {
        "required": ["message"]
      },
      "else": {
        "not": {
          "required": ["message"]
        }
      }
    },
    "http": {
      "description": "What its method's options say of it over HTTP, the .proto's words resolved (decision 0037): its idempotency_level, left out for IDEMPOTENCY_UNKNOWN, and its google.api.http rules, each of its additional_bindings a rule of its own, in their order. Its default routes are no member: a builder derives them.",
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "idempotencyLevel": {
          "description": "descriptor.proto's MethodOptions.idempotency_level, by its value's name",
          "enum": ["NO_SIDE_EFFECTS", "IDEMPOTENT"]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpRule"
          }
        }
      }
    },
    "httpRule": {
      "description": "A google.api.http rule (http.proto): its pattern's method, in upper case, its path template, and its body and its response_body where it names them.",
      "type": "object",
      "required": ["method", "template"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": ["GET", "PUT", "POST", "DELETE", "PATCH"]
        },
        "template": {
          "description": "Its path template, as http.proto's grammar writes one, which HTTP_RULE_TEMPLATE holds it to.",
          "type": "string"
        },
        "body": {
          "description": "*, the request whole, or the name of a top-level field of it; left out for no body.",
          "type": "string",
          "pattern": "^(?:\\*|[A-Za-z_][A-Za-z0-9_]*)(?![\\s\\S])"
        },
        "responseBody": {
          "description": "The name of a top-level field of its result, whose JSON is the response body.",
          "$ref": "#/$defs/protoName"
        }
      }
    },
    "admission": {
      "description": "Who may call it, its file's and its service's resolved: every call, a call with a session, or a hook the side that answers is given by its name — the runtime's AdmissionRule.",
      "oneOf": [
        {
          "enum": ["none", "session"]
        },
        {
          "type": "object",
          "required": ["hook"],
          "additionalProperties": false,
          "properties": {
            "hook": {
              "$ref": "common.schema.json#/$defs/procedureName"
            }
          }
        }
      ]
    },
    "deprecation": {
      "description": "Deprecated, with what to use instead when it says.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "description": {
      "description": "Its leading comment, by the description rule of builder/README.md: documentation, which no rule of beadc breaking reads.",
      "type": "string",
      "minLength": 1
    },
    "fullName": {
      "description": "A protobuf full name, its package and its nesting parted by dots.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
    },
    "protoPath": {
      "description": "A path from its root, as an import names it, parts by /.",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.proto(?![\\s\\S])"
    },
    "serviceName": {
      "description": "An upper-case ASCII letter, then 62 ASCII letters or digits at most.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,62}(?![\\s\\S])"
    },
    "failureName": {
      "description": "Its enum value's name, the enum's prefix taken off: upper-case ASCII letters and digits in words parted by one underscore.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*(?![\\s\\S])"
    },
    "ranges": {
      "description": "Ids from first to last, both included, in ascending order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["first", "last"],
        "additionalProperties": false,
        "properties": {
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "ruleInt32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "ruleUint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ruleInt64": {
      "description": "A 64-bit integer, as protobuf's JSON mapping writes one: a string.",
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "ruleUint64": {
      "description": "An unsigned 64-bit integer, as protobuf's JSON mapping writes one: a string.",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "ruleReal": {
      "description": "The double it is, in section 17.7.4's form, a float's widened to one; or Infinity, -Infinity or NaN, as protobuf's JSON mapping writes a value not finite.",
      "type": "string",
      "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:e[+-][0-9]+)?|Infinity|-Infinity|NaN)(?![\\s\\S])"
    },
    "ruleBytes": {
      "description": "Bytes in base64 (RFC 4648 §4), as protobuf's JSON mapping writes them.",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
    },
    "floatRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleReal"
        },
        "lt": {
          "$ref": "#/$defs/ruleReal"
        },
        "lte": {
          "$ref": "#/$defs/ruleReal"
        },
        "gt": {
          "$ref": "#/$defs/ruleReal"
        },
        "gte": {
          "$ref": "#/$defs/ruleReal"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        },
        "finite": {
          "type": "boolean"
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "doubleRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleReal"
        },
        "lt": {
          "$ref": "#/$defs/ruleReal"
        },
        "lte": {
          "$ref": "#/$defs/ruleReal"
        },
        "gt": {
          "$ref": "#/$defs/ruleReal"
        },
        "gte": {
          "$ref": "#/$defs/ruleReal"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        },
        "finite": {
          "type": "boolean"
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleReal"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "int32Rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleInt32"
        },
        "lt": {
          "$ref": "#/$defs/ruleInt32"
        },
        "lte": {
          "$ref": "#/$defs/ruleInt32"
        },
        "gt": {
          "$ref": "#/$defs/ruleInt32"
        },
        "gte": {
          "$ref": "#/$defs/ruleInt32"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt32"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt32"
          }
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt32"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "int64Rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleInt64"
        },
        "lt": {
          "$ref": "#/$defs/ruleInt64"
        },
        "lte": {
          "$ref": "#/$defs/ruleInt64"
        },
        "gt": {
          "$ref": "#/$defs/ruleInt64"
        },
        "gte": {
          "$ref": "#/$defs/ruleInt64"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt64"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt64"
          }
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInt64"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "uint32Rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleUint32"
        },
        "lt": {
          "$ref": "#/$defs/ruleUint32"
        },
        "lte": {
          "$ref": "#/$defs/ruleUint32"
        },
        "gt": {
          "$ref": "#/$defs/ruleUint32"
        },
        "gte": {
          "$ref": "#/$defs/ruleUint32"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint32"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint32"
          }
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint32"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "uint64Rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleUint64"
        },
        "lt": {
          "$ref": "#/$defs/ruleUint64"
        },
        "lte": {
          "$ref": "#/$defs/ruleUint64"
        },
        "gt": {
          "$ref": "#/$defs/ruleUint64"
        },
        "gte": {
          "$ref": "#/$defs/ruleUint64"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint64"
          }
        },
        "not_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint64"
          }
        },
        "example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleUint64"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": ["lt", "lte"]
          },
          {
            "required": ["gt", "gte"]
          }
        ]
      }
    },
    "sint32Rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "const": {
          "$ref": "#/$defs/ruleInt32"
        },
        "lt": {
          "$ref": "#/$defs/ruleInt32"
        },
        "lte": {
          "$ref": "#/$defs/ruleInt32"
