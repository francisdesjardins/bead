{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's HTTP/JSON transcoding, spec/transcoding.json",
  "type": "object",
  "required": [
    "$comment",
    "transcodingVersion",
    "defaults",
    "service",
    "templates",
    "readings",
    "writings",
    "bindings",
    "failures",
    "events",
    "exchanges"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "schemas/transcoding.schema.json" },
    "$comment": { "$ref": "common.schema.json#/$defs/comment" },
    "transcodingVersion": { "$ref": "common.schema.json#/$defs/transcodingVersion" },
    "defaults": { "$ref": "#/$defs/options" },
    "service": {
      "description": "What the Transcoding service's procedures do, by their names, what its server verifies, and the counts an exchange waits on.",
      "type": "object",
      "required": ["name", "procedures", "verifier", "counts"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "Transcoding" },
        "procedures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "verifier": { "type": "string", "minLength": 1 },
        "counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "templates": {
      "description": "Templates and raw paths: the route each path takes by the precedence, its variables and its verb; or a template refused, or two that tie (transcoding 3.5 to 3.9).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/templates" }
    },
    "readings": {
      "description": "A proto request's body, read by Bead's mapping of protobuf's JSON (transcoding 5.2 to 5.5).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reading" }
    },
    "writings": {
      "description": "A proto result, written in Bead's proto JSON form, or refused (transcoding 5.6, 5.7).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/writing" }
    },
    "bindings": {
      "description": "A request bound from its route's variables, its query and its body (transcoding 4).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    },
    "failures": {
      "description": "A call's failure, as a gateway answers it, by where it arose (transcoding 7).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/failure" }
    },
    "events": {
      "description": "A stream's call, as a gateway writes it as Server-Sent Events (transcoding 8).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/events" }
    },
    "exchanges": {
      "description": "HTTP exchanges with a gateway of the Transcoding service, over a real socket (transcoding 2 to 11).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exchange" }
    }
  },
  "$defs": {
    "clauses": {
      "description": "The units of spec/transcoding.md an entry checks: a clause, 5.2; an item of its numbered list, 5.2.1; a row of its table, counted from 1, 7.6.8.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)(\\.[1-9][0-9]*)?$" }
    },
    "message": {
      "description": "A message of spec/transcoding.proto, by its full name.",
      "type": "string",
      "pattern": "^bead\\.transcoding\\.v1\\.[A-Z][A-Za-z0-9]*$"
    },
    "procedure": {
      "description": "A procedure of the Transcoding service, by its name.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "route": {
      "description": "A route, as its rule or its default gives it: its method, its template, and its body, * or a field's name, where it has one.",
      "type": "object",
      "required": ["method", "template"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "PUT", "POST", "DELETE", "PATCH"] },
        "template": { "type": "string", "pattern": "^/" },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "upb": {
      "description": "How protobuf's own Python library parts from the entry, and the row of decision 0037's table where one says why: informative.",
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "description": "Why an entry is refused: derived, and held by the regeneration alone.",
      "type": "string",
      "minLength": 1
    },
    "options": {
      "description": "A gateway's options, by the names of transcoding 2.4, 7.6, 8.7, 8.8, 9.2, 10.3 and 11.1 and of spec 15.12, in milliseconds for a time.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "hosts": { "type": "array", "items": { "type": "string" } },
        "origins": { "type": "array", "items": { "type": "string" } },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "unnamedProxies": { "type": "integer", "minimum": 0, "maximum": 8 },
        "authorization": { "enum": ["elsewhere", "bearer-jwt"] },
        "challenge": { "type": "string", "minLength": 1 },
        "timeout": { "$ref": "common.schema.json#/$defs/duration" },
        "window": { "type": "integer", "minimum": 1 },
        "heartbeat": { "$ref": "common.schema.json#/$defs/duration" },
        "maximumExchanges": { "type": "integer", "minimum": 1 },
        "maximumExchangesPerAddress": { "type": "integer", "minimum": 1 },
        "maximumConnections": { "type": "integer", "minimum": 1 },
        "maximumConnectionsPerAddress": { "type": "integer", "minimum": 1 },
        "bodyBytesBudget": { "type": "integer", "minimum": 1 },
        "maximumBodyBytes": { "type": "integer", "minimum": 1 },
        "headersTimeout": { "$ref": "common.schema.json#/$defs/duration" },
        "minimumBodyBytesPerSecond": { "type": "integer", "minimum": 0 },
        "bodyGracePeriod": { "$ref": "common.schema.json#/$defs/duration" },
        "minimumSendBytesPerSecond": { "type": "integer", "minimum": 0 },
        "sendGracePeriod": { "$ref": "common.schema.json#/$defs/duration" },
        "maximumUnsentBytes": { "type": "integer", "minimum": 1 },
        "problemTypes": { "type": ["string", "null"] },
        "document": { "type": "boolean" }
      }
    },
    "templates": {
      "description": "Templates and raw paths, or a template refused, or two that tie.",
      "type": "object",
      "required": ["name", "clauses", "templates"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["paths"] }, { "required": ["refused"] }, { "required": ["tie"] }],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "route"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "route": { "type": ["integer", "null"], "minimum": 0 },
              "variables": { "type": "object", "additionalProperties": { "type": "string" } },
              "verb": { "type": "string" },
              "refused": { "$ref": "#/$defs/reason" }
            }
          }
        },
        "refused": { "$ref": "#/$defs/reason" },
        "tie": { "type": "boolean" }
      }
    },
    "reading": {
      "description": "A body, its text or its bytes, and the message read as its payload, or the reason it is refused for.",
      "type": "object",
      "required": ["name", "clauses", "message"],
      "additionalProperties": false,
      "allOf": [
        { "oneOf": [{ "required": ["body"] }, { "required": ["bodyBytes"] }] },
        { "oneOf": [{ "required": ["payload"] }, { "required": ["refused"] }] }
      ],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "message": { "$ref": "#/$defs/message" },
        "body": { "type": "string" },
        "bodyBytes": { "$ref": "common.schema.json#/$defs/bytes" },
        "payload": { "$ref": "common.schema.json#/$defs/bytes" },
        "refused": { "$ref": "#/$defs/reason" },
        "upb": { "$ref": "#/$defs/upb" }
      }
    },
    "writing": {
      "description": "A result's payload, and the body written of it, or the reason it is refused for.",
      "type": "object",
      "required": ["name", "clauses", "message", "payload"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["body"] }, { "required": ["refused"] }],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "message": { "$ref": "#/$defs/message" },
        "payload": { "$ref": "common.schema.json#/$defs/bytes" },
        "body": { "type": "string" },
        "refused": { "$ref": "#/$defs/reason" },
        "upb": { "$ref": "#/$defs/upb" }
      }
    },
    "binding": {
      "description": "A route, a raw target and a body, and the request's payload, or the reason it is refused for.",
      "type": "object",
      "required": ["name", "clauses", "procedure", "route", "target"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["payload"] }, { "required": ["refused"] }],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "procedure": { "$ref": "#/$defs/procedure" },
        "route": { "$ref": "#/$defs/route" },
        "target": { "type": "string", "pattern": "^/" },
        "body": { "type": "string" },
        "payload": { "$ref": "common.schema.json#/$defs/bytes" },
        "refused": { "$ref": "#/$defs/reason" }
      }
    },
    "failure": {
      "description": "A failure, where it arose, and the status, the fields and the problem a gateway answers it with.",
      "type": "object",
      "required": ["name", "clauses", "failure", "status", "fields", "problem"],
      "additionalProperties": false,
      "dependentRequired": { "procedure": ["route"], "route": ["procedure"] },
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [{ "required": ["code", "arose"] }, { "required": ["own", "detail"] }],
          "properties": {
            "code": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "scope": { "enum": ["protocol", "application"] },
            "detail": { "type": "string" },
            "arose": { "enum": ["server", "client", "answer", "gateway"] },
            "encoding": { "enum": ["proto", "json", "text", "raw"] },
            "credential": { "const": true },
            "challenge": { "type": "string", "minLength": 1 },
            "own": { "enum": ["timeout", "closed", "unwritable", "jwt", "scheme"] }
          }
        },
        "procedure": { "$ref": "#/$defs/procedure" },
        "route": { "$ref": "#/$defs/route" },
        "problemTypes": { "type": ["string", "null"] },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "problem": { "type": "string", "minLength": 2 }
      }
    },
    "data": {
      "description": "An event's data: a JSON text as it is, a text, or bytes in hexadecimal.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": { "text": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["raw"],
          "additionalProperties": false,
          "properties": { "raw": { "$ref": "common.schema.json#/$defs/bytes" } }
        }
      ]
    },
    "events": {
      "description": "What a stream's call gives, in order, and the response a gateway writes of it.",
      "type": "object",
      "required": ["name", "clauses", "steps", "status", "contentType", "body"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "result": { "$ref": "#/$defs/data" },
              "notification": { "$ref": "#/$defs/data" },
              "heartbeat": { "const": true },
              "failure": {
                "type": "object",
                "required": ["status", "problem"],
                "additionalProperties": false,
                "properties": {
                  "status": { "type": "integer", "minimum": 400, "maximum": 599 },
                  "problem": { "type": "string", "minLength": 2 }
                }
              }
            }
          }
        },
        "status": { "type": "integer", "minimum": 200, "maximum": 599 },
        "contentType": { "enum": ["text/event-stream", "application/problem+json"] },
        "body": { "type": "string" }
      }
    },
    "field": {
      "description": "A response's field: its value, null for one absent, or a shape, kept under a name where captured.",
      "oneOf": [
        { "type": "string" },
        { "type": "null" },
        {
          "type": "object",
          "required": ["shape"],
          "additionalProperties": false,
          "properties": {
            "shape": { "enum": ["etag"] },
            "capture": { "type": "string", "pattern": "^[a-z]+$" }
          }
        }
      ]
    },
    "exchange": {
      "description": "An HTTP exchange's steps, with a gateway built of its options.",
      "type": "object",
      "required": ["name", "clauses", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "#/$defs/clauses" },
        "options": { "$ref": "#/$defs/options" },
        "realTime": { "const": true },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              { "required": ["send", "on"] },
              { "required": ["expect", "on"] },
              { "required": ["close"] },
              { "required": ["until"] }
            ],
            "properties": {
              "send": {
                "type": "object",
                "required": ["head"],
                "additionalProperties": false,
                "properties": {
                  "head": { "type": "string", "minLength": 1 },
                  "body": { "$ref": "common.schema.json#/$defs/bytes" }
                }
              },
              "expect": {
                "type": "object",
                "required": ["status", "fields"],
                "additionalProperties": false,
                "oneOf": [
                  { "required": ["body"] },
                  { "required": ["bodyBytes"] },
                  { "required": ["stream"] }
                ],
                "properties": {
                  "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "fields": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/$defs/field" }
                  },
                  "body": { "type": "string" },
                  "bodyBytes": { "$ref": "common.schema.json#/$defs/bytes" },
                  "stream": { "type": "string", "minLength": 1 }
                }
              },
              "on": { "type": "string", "pattern": "^[a-z]$" },
              "close": { "type": "string", "pattern": "^[a-z]$" },
              "until": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
