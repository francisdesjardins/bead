{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's conformance vectors, spec/vectors.json",
  "type": "object",
  "required": [
    "$comment",
    "specVersion",
    "headers",
    "reads",
    "prefixes",
    "prefixRefusals",
    "headerRefusals",
    "envelopes",
    "envelopeRefusals",
    "failures",
    "failureRefusals",
    "jwtVerdicts",
    "credentialRefusals",
    "parcels",
    "parcelRefusals",
    "mqttPublishBounds"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "schemas/vectors.schema.json" },
    "$comment": { "$ref": "common.schema.json#/$defs/comment" },
    "specVersion": { "$ref": "common.schema.json#/$defs/specVersion" },
    "headers": {
      "description": "Headers a reader reads and a writer writes back to their bytes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "bytes", "header"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "header": { "$ref": "#/$defs/header" }
        }
      }
    },
    "reads": {
      "description": "Headers a reader takes, which a writer need not write: what it reads, or null for a kind skipped.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "side", "bytes", "header"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "side": { "$ref": "#/$defs/side" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "header": {
            "type": ["object", "null"],
            "if": { "type": "object" },
            "then": { "$ref": "#/$defs/header" }
          }
        }
      }
    },
    "prefixes": {
      "description": "Prefixes, read whatever follows them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "bytes", "prefix"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "prefix": {
            "type": "object",
            "required": ["layout", "kind", "callId"],
            "additionalProperties": false,
            "properties": {
              "layout": { "$ref": "common.schema.json#/$defs/u8" },
              "kind": { "$ref": "common.schema.json#/$defs/u8" },
              "callId": { "$ref": "common.schema.json#/$defs/u32" }
            }
          }
        }
      }
    },
    "prefixRefusals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/refusal" }
    },
    "headerRefusals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/refusal" }
    },
    "envelopes": {
      "description": "Whole envelopes, read and written back to their bytes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "bytes", "envelope"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "envelope": { "$ref": "#/$defs/envelope" }
        }
      }
    },
    "envelopeRefusals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/refusal" }
    },
    "failures": {
      "description": "Failures' records, and what a reader makes of them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "record", "failure"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "record": { "$ref": "common.schema.json#/$defs/bytes" },
          "failure": { "$ref": "#/$defs/failure" },
          "maximumDetailBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "failureRefusals": {
      "description": "Failures' records a reader refuses.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "record", "code"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "record": { "$ref": "common.schema.json#/$defs/bytes" },
          "code": { "$ref": "common.schema.json#/$defs/protocolCode" }
        }
      }
    },
    "jwtVerdicts": {
      "description": "JWTs verified against keys, an audience or a set of them, and the wall clock's reading, and the verdict every side gives (section 13.8).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "token", "keys", "audience", "now", "verdict"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "token": {
            "description": "The token as its CREDENTIAL block carries it.",
            "type": "string"
          },
          "keys": {
            "description": "The receiver's keys, each a JWK (RFC 7517) with its issuer and its one algorithm.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["issuer", "algorithm", "jwk"],
              "additionalProperties": false,
              "properties": {
                "issuer": { "type": "string" },
                "algorithm": { "enum": ["ES256", "HS256"] },
                "jwk": { "type": "object", "required": ["kty"] }
              }
            }
          },
          "audience": {
            "description": "The receiver's audience, or the set of them a relay that verifies holds (section 14.3), any of which the token's aud may name.",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            ]
          },
          "now": {
            "description": "The wall clock's reading, W, an RFC 3339 instant in UTC to the millisecond.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "verdict": {
            "oneOf": [
              {
                "description": "The token holds: its session's identifier, its claims set, and its end, E, in milliseconds since the epoch.",
                "type": "object",
                "required": ["holds", "identifier", "claims", "end"],
                "additionalProperties": false,
                "properties": {
                  "holds": { "const": true },
                  "identifier": {
                    "type": "object",
                    "required": ["issuer"],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": { "type": "string" },
                      "sid": { "type": "string" },
                      "sub": { "type": "string" }
                    },
                    "oneOf": [{ "required": ["sid"] }, { "required": ["sub"] }]
                  },
                  "claims": { "type": "object" },
                  "end": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "description": "The token does not hold: the step of section 13.8 that refused it.",
                "type": "object",
                "required": ["holds", "reason"],
                "additionalProperties": false,
                "properties": {
                  "holds": { "const": false },
                  "reason": {
                    "enum": [
                      "token",
                      "crit",
                      "typ",
                      "kid",
                      "alg",
                      "key",
                      "signature",
                      "iss",
                      "exp",
                      "nbf",
                      "aud",
                      "sid",
                      "sub"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "credentialRefusals": {
      "description": "Credentials a server refuses as they resolve, other than a JWT's verdicts, each in the situation both sides' tests set up, and the reason the access refused is told with (section 13.12).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "scheme", "situation", "code", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "scheme": {
            "description": "The credential scheme the request presents: by its name, or a scheme to come by its number.",
            "oneOf": [
              { "enum": ["OPAQUE", "JWT", "ELSEWHERE"] },
              { "type": "integer", "minimum": 4, "maximum": 65535 }
            ]
          },
          "situation": {
            "description": "What the test sets up before the request: an OPAQUE of a session another connection holds, or of none; an ELSEWHERE whose transport carried nothing, whose verifier settles with no session, or whose end the wall clock has reached as it settles; a scheme to come; an ELSEWHERE to a server given no verifier; a JWT to a server given no keys.",
            "enum": [
              "another-connections-session",
              "no-session",
              "nothing-carried",
              "verifier-makes-none",
              "end-come",
              "scheme-to-come",
              "no-verifier",
              "no-keys"
            ]
          },
          "code": { "$ref": "common.schema.json#/$defs/protocolCode" },
          "reason": { "enum": ["session", "nothing-carried", "verifier", "end", "scheme"] }
        }
      }
    },
    "parcels": {
      "description": "A broker's parcels, read to their fields and written back to their bytes, but those marked written false, which a reader reads alone (section 15.17).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "bytes", "parcel"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "parcel": { "$ref": "#/$defs/parcel" },
          "written": {
            "description": "false for a parcel no writer writes: an advisory kind, a layout to come, an OPEN its acceptor refuses.",
            "const": false
          }
        }
      }
    },
    "parcelRefusals": {
      "description": "Messages a side refuses as parcels: no parcel, dropped in silence and reported, or a parcel that does not read, which closes its connection with 1002 (section 15.17).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "clauses", "bytes", "refused"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
          "refused": { "enum": ["no-parcel", "does-not-read"] }
        }
      }
    },
    "mqttPublishBounds": {
      "description": "An MQTT 5 PUBLISH counted to its every byte, and the largest payload to a topic within a Maximum Packet Size, with no broker (section 15.30).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "clauses",
          "topic",
          "maximumPacketSize",
          "qos",
          "expiry",
          "largestPayload",
          "packetBytes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
          "topic": { "type": "string", "minLength": 1 },
          "maximumPacketSize": { "type": "integer", "minimum": 1, "maximum": 268435460 },
          "qos": { "enum": [0, 1] },
          "expiry": {
            "description": "true where the PUBLISH carries a Message Expiry Interval, five bytes of its properties.",
            "type": "boolean"
          },
          "largestPayload": {
            "description": "The largest payload within the bound, or null where an empty PUBLISH does not fit.",
            "type": ["integer", "null"],
            "minimum": 0
          },
          "packetBytes": {
            "description": "The bytes of the PUBLISH that payload makes, or null where none fits.",
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "half": {
      "description": "A connection's half, its opener's or its acceptor's: 8 bytes in hexadecimal, all zero where the parcel names none.",
      "type": "string",
      "pattern": "^[0-9A-F]{2}(?: [0-9A-F]{2}){7}$"
    },
    "parcel": {
      "description": "A parcel's fields: its prefix, then its body's by its kind; an advisory kind and a layout to come are read to their prefix, an OPEN of a layout to come to its id besides.",
      "type": "object",
      "required": ["layout", "kind", "opener", "acceptor", "sequence"],
      "additionalProperties": false,
      "properties": {
        "layout": { "type": "integer", "minimum": 177, "maximum": 191 },
        "kind": {
          "description": "OPEN 1, ACCEPT 2, REFUSE 3, DATA 4, PING 5, PONG 6, CLOSE 7, RESET 8, GONE 9; 128 to 255 advisory.",
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "flags": {
          "description": "MORE 1 and CREDENTIAL 2 on a DATA, SECURE 4 on an OPEN and an ACCEPT, together.",
          "$ref": "common.schema.json#/$defs/u8"
        },
        "opener": { "$ref": "#/$defs/half" },
        "acceptor": { "$ref": "#/$defs/half" },
        "sequence": { "$ref": "common.schema.json#/$defs/u53" },
        "id": { "description": "A participant's id, a character a byte.", "type": "string" },
        "incarnation": {
          "description": "A participant's incarnation, 16 bytes in hexadecimal.",
          "type": "string",
          "pattern": "^[0-9A-F]{2}(?: [0-9A-F]{2}){15}$"
        },
        "bound": { "$ref": "common.schema.json#/$defs/u32" },
        "status": { "enum": [400, 426, 503] },
        "layouts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 177, "maximum": 191 }
        },
        "credential": {
          "description": "The credential a DATA carries, a character a byte.",
          "type": "string",
          "minLength": 1
        },
        "carried": {
          "description": "What a DATA carries past its credential: an envelope, or a part of one.",
          "$ref": "common.schema.json#/$defs/bytes"
        },
        "answers": { "$ref": "common.schema.json#/$defs/u53" },
        "code": { "enum": [1000, 1001, 1002, 1009, 4000, 4001] }
      }
    },
    "side": {
      "description": "The side that reads.",
      "enum": ["client", "server"]
    },
    "refusal": {
      "description": "Bytes a reader refuses, the protocol code it answers with, and the bound it reads them with, where the vector is about that bound.",
      "type": "object",
      "required": ["name", "clauses", "bytes", "code"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
        "bytes": { "$ref": "common.schema.json#/$defs/bytes" },
        "code": { "$ref": "common.schema.json#/$defs/protocolCode" },
        "detail": { "type": "string" },
        "maximumEnvelopeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "envelope": {
      "description": "A whole envelope: its kind, which its header says too; then a failure's record for a failure, nothing for a credit or a cancel, and a payload for any other.",
      "type": "object",
      "required": ["kind", "header"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/kind" },
        "header": { "$ref": "#/$defs/header" },
        "payload": { "$ref": "common.schema.json#/$defs/bytes" },
        "failure": { "$ref": "#/$defs/failure" }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "enum": [16, 17, 19, 20] } } },
          "then": { "required": ["payload"], "properties": { "failure": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 18 } } },
          "then": { "required": ["failure"], "properties": { "payload": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "enum": [21, 22] } } },
          "then": { "properties": { "payload": false, "failure": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 16 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 16 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 17 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 17 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 18 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 18 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 19 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 19 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 20 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 20 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 21 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 21 } } } } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 22 } } },
          "then": { "properties": { "header": { "properties": { "kind": { "const": 22 } } } } }
        }
      ]
    },
    "failure": {
      "description": "A failure's record, as read: its code, its scope, the relays it crossed and its detail.",
      "type": "object",
      "required": ["code", "scope", "relays", "detail"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/code" },
        "scope": { "$ref": "common.schema.json#/$defs/scope" },
        "relays": { "$ref": "common.schema.json#/$defs/u8" },
        "detail": { "type": "string" }
      }
    },
    "header": {
      "description": "The fields a header carries, each kind its own.",
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "$ref": "common.schema.json#/$defs/kind" } },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 16 } } },
          "then": { "$ref": "#/$defs/request" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 17 } } },
          "then": { "$ref": "#/$defs/result" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 18 } } },
          "then": { "$ref": "#/$defs/failureHeader" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 19 } } },
          "then": { "$ref": "#/$defs/notification" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 20 } } },
          "then": { "$ref": "#/$defs/chunk" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 21 } } },
          "then": { "$ref": "#/$defs/credit" }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": 22 } } },
          "then": { "$ref": "#/$defs/cancel" }
        }
      ]
    },
    "request": {
      "type": "object",
      "required": ["callId", "kind", "serviceId", "procedureId"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 16 },
        "serviceId": { "$ref": "common.schema.json#/$defs/u16" },
        "procedureId": { "$ref": "common.schema.json#/$defs/u16" },
        "destinationId": { "$ref": "common.schema.json#/$defs/u32" },
        "opensSubscription": { "type": "boolean" },
        "paced": { "type": "boolean" },
        "credential": { "$ref": "#/$defs/presented" },
        "total": { "$ref": "common.schema.json#/$defs/u53" }
      }
    },
    "result": {
      "type": "object",
      "required": ["callId", "kind"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 17 },
        "credential": { "$ref": "#/$defs/announcement" },
        "total": { "$ref": "common.schema.json#/$defs/u53" }
      }
    },
    "failureHeader": {
      "type": "object",
      "required": ["callId", "kind"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 18 },
        "credential": { "$ref": "#/$defs/announcement" }
      }
    },
    "notification": {
      "type": "object",
      "required": ["callId", "kind"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 19 }
      }
    },
    "chunk": {
      "type": "object",
      "required": ["callId", "kind", "offset", "isLast"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 20 },
        "offset": { "$ref": "common.schema.json#/$defs/u53" },
        "isLast": { "type": "boolean" }
      }
    },
    "credit": {
      "type": "object",
      "required": ["callId", "kind", "creditEnd"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 21 },
        "creditEnd": { "$ref": "common.schema.json#/$defs/u53" },
        "paced": { "type": "boolean" }
      }
    },
    "cancel": {
      "type": "object",
      "required": ["callId", "kind"],
      "additionalProperties": false,
      "properties": {
        "callId": { "$ref": "common.schema.json#/$defs/u32" },
        "kind": { "const": 22 }
      }
    },
    "presented": {
      "description": "What a request presents: a credential of any scheme but NONE.",
      "$ref": "common.schema.json#/$defs/credential",
      "not": { "properties": { "scheme": { "const": "NONE" } } }
    },
    "announcement": {
      "description": "What an answer announces of its connection's session: OPAQUE, its token; NONE, its end.",
      "$ref": "common.schema.json#/$defs/credential",
      "properties": { "scheme": { "enum": ["OPAQUE", "NONE"] } }
    }
  }
}
