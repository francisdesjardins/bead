{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's transports' cases, spec/transports.json",
  "type": "object",
  "required": ["$comment", "specVersion", "defaults", "responses", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "schemas/transports.schema.json" },
    "$comment": { "$ref": "common.schema.json#/$defs/comment" },
    "specVersion": { "$ref": "common.schema.json#/$defs/specVersion" },
    "defaults": {
      "description": "The bounds' defaults, as sections 15.3 and 15.12 state them, in milliseconds for a time: each side checks its own against them.",
      "$ref": "#/$defs/bounds",
      "required": [
        "maximumConnections",
        "maximumConnectionsPerAddress",
        "maximumWaitingExchanges",
        "bodyBytesBudget",
        "maximumBodyBytes",
        "maximumOutboxBytes",
        "maximumWait",
        "exchangeTimeout",
        "inactivityTimeout",
        "maximumMessageBytes",
        "heartbeat"
      ],
      "unevaluatedProperties": false
    },
    "responses": {
      "description": "Responses as a server may cut them across reads, which every side's reader reads alike.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/response" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "properties": {
        "maximumConnections": { "type": "integer", "minimum": 1 },
        "maximumConnectionsPerAddress": { "type": "integer", "minimum": 1 },
        "maximumWaitingExchanges": { "type": "integer", "minimum": 1 },
        "bodyBytesBudget": { "type": "integer", "minimum": 1 },
        "maximumBodyBytes": { "type": "integer", "minimum": 1 },
        "maximumOutboxBytes": { "type": "integer", "minimum": 1 },
        "maximumWait": { "type": "integer", "minimum": 0 },
        "exchangeTimeout": { "type": "integer", "minimum": 1 },
        "inactivityTimeout": { "type": "integer", "minimum": 1 },
        "maximumMessageBytes": { "type": "integer", "minimum": 1 },
        "heartbeat": { "type": "integer", "minimum": 1 }
      }
    },
    "options": {
      "description": "The server's bounds a case sets, and what it takes besides: hosts, origins, a proxy it trusts.",
      "type": "object",
      "minProperties": 1,
      "$ref": "#/$defs/bounds",
      "unevaluatedProperties": false,
      "properties": {
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "isProxyTrusted": { "type": "boolean" }
      }
    },
    "response": {
      "type": "object",
      "required": ["name", "pieces", "status", "fields", "body"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "pieces": {
          "description": "The response's octets, in the reads they come in.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/bytes" }
        },
        "status": { "$ref": "#/$defs/status" },
        "fields": {
          "description": "What the reader finds of its fields, by name in lower case.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": { "$ref": "common.schema.json#/$defs/bytes" }
      }
    },
    "case": {
      "description": "What a server of the interop service does at its transport's edge with what a peer of the test's own sends it.",
      "type": "object",
      "required": ["name", "clauses", "transport", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
        "transport": { "enum": ["http"] },
        "options": { "$ref": "#/$defs/options" },
        "differs": {
          "description": "The rows of docs/support.md a case crosses, each naming the case, and the language each excuses from it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["row", "language"],
            "additionalProperties": false,
            "properties": {
              "row": { "type": "string", "minLength": 1 },
              "language": { "enum": ["TypeScript", "C#"] }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "exchange": {
      "description": "An exchange's name, its own socket.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "step": {
      "description": "What the test does — send, close, until, stop — or what the server under test does next — expect, report: one of them, on the exchange it names, where it has one.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["send", "on"] },
        { "required": ["expect", "on"] },
        { "required": ["close", "on"] },
        { "required": ["until"] },
        { "required": ["report"] },
        { "required": ["stop"] }
      ],
      "properties": {
        "on": { "$ref": "#/$defs/exchange" },
        "send": {
          "type": "object",
          "required": ["head"],
          "additionalProperties": false,
          "properties": {
            "head": {
              "description": "The request's line and fields, as text, CRLF after each and one more after the last; {host} and a captured value's {name} put in.",
              "type": "string",
              "pattern": "^[A-Z]+ \\S+ HTTP/1\\.1\\r\\n(?:[a-z0-9-]+: [^\\r\\n]*\\r\\n)*\\r\\n$"
            },
            "body": { "$ref": "common.schema.json#/$defs/bytes" }
          }
        },
        "expect": { "$ref": "#/$defs/expectation" },
        "close": { "const": true },
        "until": {
          "description": "A gauge of the transport, which both sides name alike, and the value it waits for.",
          "type": "object",
          "required": ["gauge", "is"],
          "additionalProperties": false,
          "properties": {
            "gauge": {
              "enum": [
                "connections",
                "addresses",
                "bodyBytes",
                "listens",
                "waitingExchanges",
                "buriedCallIds",
                "outboxEnvelopes"
              ]
            },
            "is": { "type": "integer", "minimum": 0 }
          }
        },
        "report": {
          "description": "A code, or exception for an error that carries none.",
          "type": ["integer", "string"],
          "if": { "type": "integer" },
          "then": { "$ref": "common.schema.json#/$defs/code" },
          "else": { "const": "exception" }
        },
        "stop": { "const": true }
      }
    },
    "expectation": {
      "description": "A response: its status, its fields, and its body exactly, or the one envelope it holds, or the envelopes of its batch.",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "dependentSchemas": {
        "body": { "not": { "anyOf": [{ "required": ["envelope"] }, { "required": ["batch"] }] } },
        "envelope": { "not": { "required": ["batch"] } }
      },
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" },
              {
                "type": "object",
                "required": ["shape"],
                "additionalProperties": false,
                "properties": {
                  "shape": { "$ref": "#/$defs/shape" },
                  "capture": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
                }
              }
            ]
          }
        },
        "body": { "$ref": "common.schema.json#/$defs/bytes" },
        "envelope": { "$ref": "conversations.schema.json#/$defs/expect" },
        "batch": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "conversations.schema.json#/$defs/expect" }
        }
      }
    },
    "shape": {
      "description": "token: 16 bytes in base64url without padding; delay-seconds: a number of seconds in ASCII digits; http-date: an IMF-fixdate.",
      "enum": ["token", "delay-seconds", "http-date"]
    },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 }
  }
}
