{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bead's transports' cases, spec/transports.json",
  "type": "object",
  "required": ["$comment", "specVersion", "wallClock", "defaults", "responses", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "schemas/transports.schema.json" },
    "$comment": { "$ref": "common.schema.json#/$defs/comment" },
    "specVersion": { "$ref": "common.schema.json#/$defs/specVersion" },
    "wallClock": { "$ref": "common.schema.json#/$defs/wallClock" },
    "defaults": {
      "description": "The bounds' defaults, as sections 15.3 and 15.12 state them, in milliseconds for a time: each side checks its own against them.",
      "$ref": "#/$defs/bounds",
      "required": [
        "maximumConnections",
        "maximumConnectionsPerAddress",
        "maximumWaitingExchanges",
        "bodyBytesBudget",
        "maximumBodyBytes",
        "maximumOutboxBytes",
        "maximumWait",
        "exchangeTimeout",
        "inactivityTimeout",
        "connectionInactivityTimeout",
        "minimumSendBytesPerSecond",
        "sendGracePeriod",
        "maximumUnsentBytes",
        "headersTimeout",
        "minimumBodyBytesPerSecond",
        "bodyGracePeriod",
        "maximumMessageBytes",
        "heartbeat"
      ],
      "unevaluatedProperties": false
    },
    "responses": {
      "description": "Responses as a server may cut them across reads, which every side's reader reads alike.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/response" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "properties": {
        "maximumConnections": { "type": "integer", "minimum": 1 },
        "maximumConnectionsPerAddress": { "type": "integer", "minimum": 1 },
        "maximumWaitingExchanges": { "type": "integer", "minimum": 1 },
        "bodyBytesBudget": { "type": "integer", "minimum": 1 },
        "maximumBodyBytes": { "type": "integer", "minimum": 1 },
        "maximumOutboxBytes": { "type": "integer", "minimum": 1 },
        "maximumWait": { "$ref": "common.schema.json#/$defs/duration" },
        "exchangeTimeout": { "$ref": "common.schema.json#/$defs/duration" },
        "inactivityTimeout": { "$ref": "common.schema.json#/$defs/duration" },
        "connectionInactivityTimeout": {
          "description": "The HTTP server's own connection timeout, its server layer's (spec 13.7), not its transport's.",
          "$ref": "common.schema.json#/$defs/duration"
        },
        "minimumSendBytesPerSecond": {
          "description": "The slowest a socket may take what waits for it once its grace passed, in bytes a second; 0 holds none (spec 15.12).",
          "type": "integer",
          "minimum": 0
        },
        "sendGracePeriod": { "$ref": "common.schema.json#/$defs/duration" },
        "maximumUnsentBytes": {
          "description": "What waits for a WebSocket's socket, at most (spec 15.12).",
          "type": "integer",
          "minimum": 1
        },
        "headersTimeout": { "$ref": "common.schema.json#/$defs/duration" },
        "minimumBodyBytesPerSecond": { "type": "integer", "minimum": 1 },
        "bodyGracePeriod": { "$ref": "common.schema.json#/$defs/duration" },
        "maximumMessageBytes": { "type": "integer", "minimum": 1 },
        "heartbeat": { "$ref": "common.schema.json#/$defs/duration" }
      }
    },
    "options": {
      "description": "The server's bounds a case sets, and what it takes besides: hosts, origins, the proxies it trusts, and how many it counts that trustedProxies does not name.",
      "type": "object",
      "minProperties": 1,
      "$ref": "#/$defs/bounds",
      "unevaluatedProperties": false,
      "properties": {
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "trustedProxies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unnamedProxies": {
          "description": "The proxies on every path to the server that trustedProxies does not name, each one of the count (spec 15.12).",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["name", "pieces", "status", "fields", "body"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "pieces": {
          "description": "The response's octets, in the reads they come in.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/bytes" }
        },
        "status": { "$ref": "#/$defs/status" },
        "fields": {
          "description": "What the reader finds of its fields, by name in lower case.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": { "$ref": "common.schema.json#/$defs/bytes" }
      }
    },
    "case": {
      "description": "What a server of the interop service does at its transport's edge with what a peer of the test's own sends it.",
      "type": "object",
      "required": ["name", "clauses", "transport", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "clauses": { "$ref": "common.schema.json#/$defs/clauses" },
        "transport": { "enum": ["http", "websocket"] },
        "limits": { "$ref": "conversations.schema.json#/$defs/limits" },
        "answersPings": {
          "description": "false for a peer that leaves the server's pings unanswered; its pings are answered otherwise.",
          "const": false
        },
        "realTime": {
          "description": "A case played on the real clock, as what no clock given reaches is.",
          "const": true
        },
        "options": { "$ref": "#/$defs/options" },
        "differs": { "$ref": "common.schema.json#/$defs/differs" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "exchange": {
      "description": "An exchange's name, its own socket.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "step": {
      "description": "What the test does — send, close, until, stop — or what the server under test does next — expect, report: one of them, on the exchange it names, where it has one.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["send", "on"] },
        { "required": ["expect", "on"] },
        { "required": ["close", "on"] },
        { "required": ["until"] },
        { "required": ["report"] },
        { "required": ["stop"] },
        { "required": ["advance"] },
        { "required": ["wall"] }
      ],
      "dependentRequired": { "after": ["expect"] },
      "properties": {
        "on": { "$ref": "#/$defs/exchange" },
        "within": {
          "description": "How long an expect waits, in milliseconds, where not a patience of its own.",
          "type": "integer",
          "minimum": 1
        },
        "after": {
          "description": "The least an expect waits, in milliseconds from its step's start as within counts them: what it reads that comes sooner fails the step.",
          "type": "integer",
          "minimum": 0
        },
        "send": { "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/message" }] },
        "expect": { "oneOf": [{ "$ref": "#/$defs/expectation" }, { "$ref": "#/$defs/heard" }] },
        "close": { "const": true },
        "advance": { "$ref": "common.schema.json#/$defs/advance" },
        "wall": { "$ref": "common.schema.json#/$defs/wall" },
        "until": {
          "description": "A gauge of the transport, which both sides name alike, and the value it waits for; or a timer armed on the side's given clock.",
          "type": "object",
          "oneOf": [{ "required": ["gauge", "is"] }, { "required": ["timer"] }],
          "additionalProperties": false,
          "properties": {
            "timer": { "$ref": "common.schema.json#/$defs/timer" },
            "gauge": {
              "enum": [
                "connections",
                "addresses",
                "bodyBytes",
                "listens",
                "waitingExchanges",
                "buriedCallIds",
                "outboxEnvelopes"
              ]
            },
            "is": { "type": "integer", "minimum": 0 }
          }
        },
        "report": {
          "description": "A code, or exception for an error that carries none.",
          "type": ["integer", "string"],
          "if": { "type": "integer" },
          "then": { "$ref": "common.schema.json#/$defs/code" },
          "else": { "const": "exception" }
        },
        "stop": { "const": true }
      }
    },
    "request": {
      "description": "A request of HTTP/1.1, an opening handshake among them, or of HTTP/1.0.",
      "type": "object",
      "required": ["head"],
      "additionalProperties": false,
      "properties": {
        "head": {
          "description": "The request's line and fields, as text, CRLF after each and one more after the last, or none for a head that never comes whole; {host} and a captured value's {name} put in. Each character is one octet, its code point (ISO-8859-1), so one past U+007F is an octet past ASCII; its target holds any octet but a space and LF, a control character, HTAB and a bare CR among them.",
          "type": "string",
          "pattern": "^[A-Z]+ (?:[^ \\r\\n\\u0100-\\uffff]|\\r(?!\\n))+ HTTP/1\\.[01]\\r\\n(?:[a-z0-9-]+: [^\\r\\n\\u0100-\\uffff]*\\r\\n)*(?:\\r\\n)?$"
        },
        "body": { "$ref": "common.schema.json#/$defs/bytes" }
      }
    },
    "message": {
      "description": "What the peer writes on a WebSocket: a binary message, a text one, frames of its own, or a close.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "binary": { "$ref": "common.schema.json#/$defs/bytes" },
        "text": { "type": "string" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["opcode", "fin", "payload"],
            "additionalProperties": false,
            "properties": {
              "opcode": { "type": "integer", "minimum": 0, "maximum": 15 },
              "fin": { "type": "boolean" },
              "payload": { "$ref": "common.schema.json#/$defs/bytes" }
            }
          }
        },
        "close": { "$ref": "#/$defs/closeCode" }
      }
    },
    "heard": {
      "description": "What the server sends next on a WebSocket: a binary message holding an envelope, or its bytes, a close and its code, a ping, or the socket's end; on an HTTP exchange, past its response, the socket's end alone.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "envelope": { "$ref": "conversations.schema.json#/$defs/expect" },
        "binary": { "$ref": "common.schema.json#/$defs/bytes" },
        "close": { "$ref": "#/$defs/closeCode" },
        "ping": { "const": true },
        "end": { "const": true }
      }
    },
    "closeCode": { "type": "integer", "minimum": 1000, "maximum": 4999 },
    "expectation": {
      "description": "A response: its status, its fields, and its body exactly, or the one envelope it holds, or the envelopes of its batch.",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "dependentSchemas": {
        "body": { "not": { "anyOf": [{ "required": ["envelope"] }, { "required": ["batch"] }] } },
        "envelope": { "not": { "required": ["batch"] } }
      },
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "orLost": {
          "description": "The exchange may be lost instead, its socket ending before any status (spec 15.7).",
          "const": true
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" },
              {
                "type": "object",
                "required": ["shape"],
                "additionalProperties": false,
                "properties": {
                  "shape": { "$ref": "#/$defs/shape" },
                  "capture": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
                }
              }
            ]
          }
        },
        "body": { "$ref": "common.schema.json#/$defs/bytes" },
        "envelope": { "$ref": "conversations.schema.json#/$defs/expect" },
        "batch": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "conversations.schema.json#/$defs/expect" }
        },
        "told": {
          "description": "On a marked refusal, what the server's transport tells of it (spec 15.1), or null where it tells nothing.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/refusal" }]
        }
      }
    },
    "refusal": {
      "description": "A refusal told: its status, its reason, the request's authority and its Origin as they came, the field's lines joined by \", \", null for none, the client's address, and its port, {port}, the local port of the socket the exchange was sent on.",
      "type": "object",
      "required": ["status", "reason", "authority", "origin", "address", "port"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "authority": { "type": ["string", "null"] },
        "origin": { "type": ["string", "null"] },
        "address": { "type": "string", "minLength": 1 },
        "port": { "const": "{port}" }
      }
    },
    "shape": {
      "description": "token: 16 bytes in base64url without padding; delay-seconds: a number of seconds in ASCII digits; http-date: an IMF-fixdate.",
      "enum": ["token", "delay-seconds", "http-date"]
    },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 }
  }
}
