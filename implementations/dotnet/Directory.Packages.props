<Project>
  <!-- One version per package, for every project, as `yarn constraints` holds one per dependency. -->
  <ItemGroup>
    <!-- AMQP 1.0's client beneath Bead.Transport.Amqp, its automation turned off by its adapter (0043): its
         netstandard package, Apache-2.0, on which RabbitMQ's own .NET client builds; pinned, since the
         bytes of each message are its encoders', which spec/vectors.json's amqpMessages holds to the
         profile at this version, and an upgrade that writes another encoding fails it -->
    <PackageVersion Include="AMQPNetLite.Core" Version="2.5.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- MQTT 5's client beneath Bead.Transport.Mqtt, its automation turned off by its adapter (0041) -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
