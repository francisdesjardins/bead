<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 runs its tests as a program of their own -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bead.Protobuf.Tests</RootNamespace>
    <!-- a test says what it shows by its name -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Probe, the message of the codecs' proto rows: a packed run, a repeated fixed32, a map of
         messages, a group, and a message of its own kind, generated as each build runs -->
    <Protobuf Include="../../../../spec/codecs.proto" ProtoRoot="../../../../spec" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Protobuf/Bead.Protobuf.csproj" />
  </ItemGroup>
</Project>
