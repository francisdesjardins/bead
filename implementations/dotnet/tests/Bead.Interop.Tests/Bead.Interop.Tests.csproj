<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 runs its tests as a program of their own -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bead.Interop.Tests</RootNamespace>
    <!-- a test says what it shows by its name -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Transport.Http/Bead.Transport.Http.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <ProjectReference Include="../../interop/Bead.Interop/Bead.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON as a service manager's accessor takes it, for the calls no generated client makes -->
    <Compile Include="../Shared/JsonPayloads.cs" Link="JsonPayloads.cs" />
  </ItemGroup>
</Project>
