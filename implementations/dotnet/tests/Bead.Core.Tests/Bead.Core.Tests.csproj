<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 runs its tests as a program of their own -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bead.Tests</RootNamespace>
    <!-- a test says what it shows by its name -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Core/Bead.Core.csproj" />
    <ProjectReference Include="../../interop/Bead.Interop/Bead.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the conformance vectors, the conversations and the clock cases: the files both implementations' tests read -->
    <Content Include="../../../../spec/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../spec/conversations.json" Link="conversations.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../spec/clocks.json" Link="clocks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the clock the conformance files' harnesses give the side under test, shared with the transports' -->
    <Compile Include="../Shared/SteppingClock.cs" Link="SteppingClock.cs" />
  </ItemGroup>
</Project>
