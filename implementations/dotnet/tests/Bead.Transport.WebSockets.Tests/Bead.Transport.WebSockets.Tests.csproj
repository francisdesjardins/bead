<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 runs its tests as a program of their own -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bead.Transport.WebSockets.Tests</RootNamespace>
    <!-- a test says what it shows by its name -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- the durations, the file both implementations' tests read -->
    <Content Include="../../../../spec/durations.json" Link="durations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the clock the conformance files' harnesses give the side under test, whose timers armed a test reads -->
    <Compile Include="../Shared/SteppingClock.cs" Link="SteppingClock.cs" />
    <!-- what reads the durations, for the client's way of a WebSocket's close timeout, which its tests play -->
    <Compile Include="../Shared/Durations.cs" Link="Durations.cs" />
    <!-- JSON as a service manager's accessor takes it, for the calls no generated client makes -->
    <Compile Include="../Shared/JsonPayloads.cs" Link="JsonPayloads.cs" />
    <!-- the addresses a server listens on, and the forms it refuses, as the TypeScript side's tests hold them -->
    <Compile Include="../Shared/Addresses.cs" Link="Addresses.cs" />
    <!-- what a client transport's send gives in each state, as the TypeScript side's sendRefusalOf reads it -->
    <Compile Include="../Shared/SendRefusals.cs" Link="SendRefusals.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <ProjectReference Include="../../interop/Bead.Interop/Bead.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test PKI every side's TLS tests read (spec 15.39), and the TLS front of their twins,
         whose assembly fixture cleans the user's CA store on Windows -->
    <Content Include="../../../../spec/pki/*.pem;../../../../spec/pki/*.key" LinkBase="pki" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/Pki.cs" Link="Pki.cs" />
    <Compile Include="../Shared/TlsFront.cs" Link="TlsFront.cs" />
  </ItemGroup>
</Project>
