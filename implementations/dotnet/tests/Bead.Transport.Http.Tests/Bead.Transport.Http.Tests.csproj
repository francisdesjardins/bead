<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 runs its tests as a program of their own -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bead.Transport.Http.Tests</RootNamespace>
    <!-- a test says what it shows by its name -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Transport.Http/Bead.Transport.Http.csproj" />
    <!-- a relay over HTTP to a target behind a WebSocket -->
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <ProjectReference Include="../../interop/Bead.Interop/Bead.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the transports' cases and the durations: the files both implementations' tests read -->
    <Content Include="../../../../spec/transports.json" Link="transports.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../spec/durations.json" Link="durations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the clock the conformance files' harnesses give the side under test, shared with the conversations' -->
    <Compile Include="../Shared/SteppingClock.cs" Link="SteppingClock.cs" />
    <!-- what reads the durations, for the harness that plays every place -->
    <Compile Include="../Shared/Durations.cs" Link="Durations.cs" />
  </ItemGroup>
</Project>
