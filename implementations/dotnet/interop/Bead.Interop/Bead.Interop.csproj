<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead's interop service, as the C# side offers it: what spec/interop-blueprint.json and
       spec/interop-service.json describe. -->
  <PropertyGroup>
    <RootNamespace>Bead.Interop</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Core/Bead.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- what the procedures' parsers take, for the tests to hold -->
    <InternalsVisibleTo Include="Bead.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the interop service's files, which every implementation's interop server reads -->
    <Content Include="../../../../spec/interop-blueprint.json" Link="interop-blueprint.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../spec/interop-service.json" Link="interop-service.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
