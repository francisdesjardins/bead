<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead's interop service, as the C# side offers it: its server and client generated from
       spec/interop-blueprint.json into Generated/, its resolvers and credentials written, as
       spec/interop-service.json describes them. -->
  <PropertyGroup>
    <RootNamespace>Bead.Interop</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Core/Bead.Core.csproj" />
    <ProjectReference Include="../../src/Bead.Protobuf/Bead.Protobuf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- no service manager's accessor called by hand: the generated server and client stand for them (0022) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- what the procedures' parsers take, for the tests to hold -->
    <InternalsVisibleTo Include="Bead.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the interop service's credentials, which every implementation's interop server reads -->
    <Content Include="../../../../spec/interop-service.json" Link="interop-service.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
