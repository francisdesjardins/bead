<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# server of Bead's interop service, over WebSocket, HTTP, MQTT 5 and AMQP 1.0: what a client of any implementation calls. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bead.Interop.Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bead.Interop/Bead.Interop.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.Http/Bead.Transport.Http.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.Mqtt/Bead.Transport.Mqtt.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.Amqp/Bead.Transport.Amqp.csproj" />
    <ProjectReference Include="../../src/Bead.Transcoding.Http/Bead.Transcoding.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the same in-process service fixture each side's gateway unit tests call -->
    <Compile Include="../../tests/Bead.Transcoding.Tests/TranscodingService.cs" Link="TranscodingService.cs" />
    <Compile Include="../../tests/Bead.Transcoding.Tests/Generated/**/*.cs" Link="Transcoding/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- no service manager's accessor called by hand: the generated server and client stand for them (0022) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
</Project>
