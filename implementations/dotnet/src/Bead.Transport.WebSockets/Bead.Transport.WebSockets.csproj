<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead over WebSocket, on Kestrel: what Bead's ws-transport-server is, on ASP.NET Core. -->
  <PropertyGroup>
    <RootNamespace>Bead.Transport.WebSockets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bead.Core/Bead.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the tests see each application a start builds, and give a connection a socket of theirs;
         the defaults gate reads the bound a server takes when told none -->
    <InternalsVisibleTo Include="Bead.Transport.WebSockets.Tests" />
    <InternalsVisibleTo Include="Bead.Transport.Http.Tests" />
    <!-- the fuzz target judges an upgrade as the server does, before its 101 -->
    <InternalsVisibleTo Include="Bead.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- what Bead times takes the clock it is given, never the platform's own: 0011 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
</Project>
