<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead's envelope, written and read at fixed offsets: what the routers of both sides build on. -->
  <PropertyGroup>
    <RootNamespace>Bead</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the tests run a router on a scheduler they wait on, so they know when it settled -->
    <InternalsVisibleTo Include="Bead.Core.Tests" />
    <InternalsVisibleTo Include="Bead.Transport.Http.Tests" />
    <!-- the transports share what makes a client reconnect, as the TypeScript side's createTransportClient -->
    <InternalsVisibleTo Include="Bead.Transport.Http" />
    <InternalsVisibleTo Include="Bead.Transport.WebSockets" />
    <!-- the interop service holds a duration a payload gives as every place of this side does -->
    <InternalsVisibleTo Include="Bead.Interop" />
  </ItemGroup>

  <ItemGroup>
    <!-- what Bead times takes the clock it is given, never the platform's own: 0011 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
</Project>
