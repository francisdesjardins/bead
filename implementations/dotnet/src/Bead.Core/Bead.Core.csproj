<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead's envelope, written and read at fixed offsets: what the routers of both sides build on. -->
  <PropertyGroup>
    <RootNamespace>Bead</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the tests run a router on a scheduler they wait on, so they know when it settled -->
    <InternalsVisibleTo Include="Bead.Core.Tests" />
    <InternalsVisibleTo Include="Bead.Transport.Http.Tests" />
    <!-- the WebSocket server's tests draw a port held on ::1, and refuse its bind, as the HTTP one's -->
    <InternalsVisibleTo Include="Bead.Transport.WebSockets.Tests" />
    <!-- the transports share what makes a client reconnect, as the TypeScript side's createTransportClient -->
    <InternalsVisibleTo Include="Bead.Transport.Http" />
    <InternalsVisibleTo Include="Bead.Transport.WebSockets" />
    <!-- the interop service holds a duration a payload gives as every place of this side does -->
    <InternalsVisibleTo Include="Bead.Interop" />
    <!-- the fuzz targets read the parsers held here, the transports' fields and the JWT verifier among them -->
    <InternalsVisibleTo Include="Bead.Fuzz" />
    <!-- a gateway reads and writes JSON by the payloads' own tokens, and judges a request by the
         HTTP server's gates, its hosts, its origins, its proxies and its bounds (decision 0037) -->
    <InternalsVisibleTo Include="Bead.Transcoding" />
    <InternalsVisibleTo Include="Bead.Transcoding.Http" />
    <InternalsVisibleTo Include="Bead.Transcoding.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- what Bead times takes the clock it is given, never the platform's own: 0011 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
</Project>
