<Project>
  <!--
    Every project of Bead's C# side is judged by the same rules, as the TypeScript side is by its
    one configuration (0005): one framework, the analyzers at their recommended set, the code style
    held in the build, and a warning the build does not pass. 0007 is the decision.
  -->
  <PropertyGroup>
    <!-- the TypeScript side's version too: one version for Bead, moved by each release -->
    <Version>0.4.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- every public member says what it is; and IDE0005, unused usings, runs at build only with it -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- in CI, a restore that would change a lock file fails, as Yarn's immutable install does -->
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- every package restored, direct or transitive, against the advisories NuGet knows: one of any
         severity is a warning, so an error, and the build stops on it -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- an async lambda given where a void delegate goes, an event's listener among them, is an
         async void whose exception ends the process: VSTHRD100 and VSTHRD101, .editorconfig says
         which of the others are off and why -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
