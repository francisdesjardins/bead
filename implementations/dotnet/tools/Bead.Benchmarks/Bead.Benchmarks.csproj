<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side's measurement, the TypeScript side's tools/bench.mjs in the same units: the
       envelope codec, and a call over a WebSocket on the loopback. It stays outside Bead.slnx, run
       by hand with `dotnet run -c Release`, and builds under this side's gates all the same. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bead.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tests/Shared/JsonPayloads.cs" Link="JsonPayloads.cs" />
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <ProjectReference Include="../../interop/Bead.Interop/Bead.Interop.csproj" />
  </ItemGroup>
</Project>
