<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bead's parsers fed raw bytes, guided by coverage: the targets the TypeScript side's
       tools/fuzz holds, one for one. libFuzzer runs this executable as its child, one target by
       its name, once SharpFuzz has instrumented Bead.Core, Bead.Transport.WebSockets, Bead.Protobuf,
       Bead.Transcoding and Google.Protobuf in a copy of its build; tools/fuzz.mjs at the root does both. It builds and is formatted with the
       solution, and needs neither the fuzzer nor the instrumentation to. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bead.Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- a target that holds more than 256 MiB of managed memory runs out of it, a finding: libFuzzer
         measures its own process, not this one -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="268435456" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Core/Bead.Core.csproj" />
    <!-- the runtime codec of a proto message, which the proto-codecs target reads and writes through -->
    <ProjectReference Include="../../src/Bead.Protobuf/Bead.Protobuf.csproj" />
    <ProjectReference Include="../../src/Bead.Transport.WebSockets/Bead.Transport.WebSockets.csproj" />
    <!-- Bead's own mapping of protobuf's JSON, which the json-form target reads and writes through -->
    <ProjectReference Include="../../src/Bead.Transcoding/Bead.Transcoding.csproj" />
    <PackageReference Include="SharpFuzz" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Probe, the message of the codecs' proto rows, generated as each build runs -->
    <Protobuf Include="../../../../spec/codecs.proto" ProtoRoot="../../../../spec" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything and Edges, the json-form target's messages, compiled from the transcoding tests'
         generated spec/transcoding.proto, and the files it imports, without a second copy -->
    <Compile Include="../../tests/Bead.Transcoding.Tests/Generated/Bead/Transcoding/V1/Transcoding.cs" Link="Generated/Transcoding.cs" />
    <Compile Include="../../tests/Bead.Transcoding.Tests/Generated/Bead/Transcoding/V1/TranscodingRequired.cs" Link="Generated/TranscodingRequired.cs" />
    <Compile Include="../../tests/Bead.Transcoding.Tests/Generated/Bead/Protobuf/Options.cs" Link="Generated/Options.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- what a broker's parcel reader and writer hold of any bytes, BrokerParcelFuzzTests's own -->
    <Compile Include="../../tests/Shared/ParcelProperties.cs" Link="ParcelProperties.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the JWT target's keys, as the verdicts write them -->
    <Content Include="../../../../spec/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
