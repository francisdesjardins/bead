<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side's testee of the protovalidate differential (0035): each case read through the
       codec beadc generates for spec/validations.proto, then judged by its generated validator.
       tools/protovalidate-differential.mjs generates Generated/ at run time, never committed, so the
       project stays outside Bead.slnx; it builds under this side's gates all the same. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bead.ProtovalidateDifferential</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bead.Core/Bead.Core.csproj" />
    <ProjectReference Include="../../src/Bead.Protobuf/Bead.Protobuf.csproj" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
</Project>
