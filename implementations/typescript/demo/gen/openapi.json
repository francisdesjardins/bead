{
  "components": {
    "schemas": {
      "Problem": {
        "description": "A failure, as RFC 9457 writes one (transcoding 7).",
        "properties": {
          "code": {
            "description": "The code, as the wire carries it.",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "protocol",
              "application"
            ]
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "description": "The code's name, or the status's phrase for about:blank.",
            "type": "string"
          },
          "type": {
            "description": "The problem's identity: a protocol code's tag: URI, an application failure's under the project's problem types, or about:blank.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "status",
          "title",
          "type"
        ],
        "type": "object"
      },
      "ValidationProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "properties": {
              "errors": {
                "items": {
                  "properties": {
                    "bounds": {},
                    "detail": {
                      "type": "string"
                    },
                    "fieldPath": {
                      "type": "string"
                    },
                    "forKey": {
                      "type": "boolean"
                    },
                    "parameter": {
                      "description": "Its field, bound by a variable or a parameter of the query.",
                      "type": "string"
                    },
                    "pointer": {
                      "description": "Its field in the body, RFC 6901 §6's fragment by JSON names.",
                      "type": "string"
                    },
                    "ruleId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail",
                    "ruleId"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "more": {
                "minimum": 1,
                "type": "integer"
              },
              "stopped": {
                "const": true
              }
            },
            "required": [
              "errors"
            ],
            "type": "object"
          }
        ],
        "description": "PAYLOAD_INVALID: the request its message's rules refused, each violation an error (decision 0035)."
      },
      "demo.v1.SignUpRequest": {
        "additionalProperties": false,
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "email",
                    "phone"
                  ]
                }
              ]
            }
          },
          {
            "anyOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "phone"
                ]
              }
            ]
          }
        ],
        "description": "demo.v1.SignUpRequest. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "email": {
            "allOf": [
              {
                "type": "string"
              },
              {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "allOf": [
                      {
                        "maxLength": 254
                      },
                      {
                        "pattern": "^[^@ ]+@[^@ .]+(\\.[^@ .]+)+$"
                      }
                    ]
                  }
                ]
              }
            ],
            "description": "A local part, an @ and a domain with a dot, within RFC 5321's 254 octets of a path."
          },
          "name": {
            "allOf": [
              {
                "type": "string"
              },
              {
                "minLength": 1
              },
              {
                "maxLength": 63
              },
              {
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            ],
            "description": "A DNS label's shape (RFC 1035 2.3.1): a lower-case letter, then letters, digits or hyphens."
          },
          "phone": {
            "allOf": [
              {
                "type": "string"
              },
              {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "allOf": [
                      {
                        "pattern": "^\\+[1-9][0-9]{6,14}$"
                      }
                    ]
                  }
                ]
              }
            ],
            "description": "An E.164 number: a +, then 7 to 15 digits, the first not 0."
          },
          "seats": {
            "allOf": [
              {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              },
              {
                "maximum": 10,
                "minimum": 1
              }
            ],
            "description": "From 1 to 10."
          }
        },
        "type": "object"
      },
      "demo.v1.SignUpResponse": {
        "additionalProperties": false,
        "description": "demo.v1.SignUpResponse. Bead's mapping reads each field by its proto name too.",
        "properties": {
          "welcome": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "credential": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "SignUp",
    "version": "SignUp.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.1",
  "paths": {
    "/api/SignUp/signUp": {
      "post": {
        "description": "Holds seats for a name, to be confirmed by email or by phone.",
        "operationId": "SignUp.signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/demo.v1.SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.v1.SignUpResponse"
                }
              }
            },
            "description": "The result."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "PAYLOAD_INVALID: its request's rules refused it."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A failure (transcoding 7)."
          }
        },
        "security": [
          {},
          {
            "credential": []
          }
        ],
        "summary": "Holds seats for a name, to be confirmed by email or by phone.",
        "tags": [
          "SignUp"
        ],
        "x-bead": {
          "procedure": "signUp",
          "procedureId": 1,
          "procedureKind": "request",
          "service": "SignUp",
          "serviceId": 2
        }
      }
    }
  },
  "tags": [
    {
      "description": "Signs a visitor up for a workshop, once the request holds to its rules.",
      "name": "SignUp"
    }
  ]
}
