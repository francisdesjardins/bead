{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",

  // One house style for the TypeScript side, and for the repository's root files, which CI holds to
  // it with `-c` pointing here. oxfmt walks up from the directory it is run in, so no folder below
  // needs a file of its own.
  //
  // This is the whole of the formatting opinion. Nothing in `.oxlintrc.json` repeats it:
  // `arrow-parens` is a lint rule this repository does not enable, because it is settled here.
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "proseWrap": "preserve",
  "sortPackageJson": true,
  // `_pb.ts` is protoc-gen-es's, committed as it writes it: `tools/check-protobuf.mjs` holds it to
  // its generator instead. `_bead.ts` is beadc's, laid out by its generator and never by a
  // formatter: `beadc generate --check` holds it (decision 0022), and so is its route table,
  // `bead_http.ts`, in an output with `http: true` (decision 0037). A `.blueprint.json`, the demo's
  // in `demo/gen/`, is beadc's too, in its one form, which `generate --check` holds alike.
  // `demo/samples.ts` is `demo/make-samples.ts`'s, which the demo's tests hold it to.
  "ignorePatterns": [
    ".yarn/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*_pb.ts",
    "**/*_bead.ts",
    "**/bead_http.ts",
    "**/*.blueprint.json",
    "demo/samples.ts"
  ]
}
