{
  // The testee of the protovalidate differential, with the code tools/protovalidate-differential.mjs
  // generates into `generated/` at run time: neither the package's own type-check nor its lint can
  // read it without that code. beadc's output names each file it imports by its `.ts`, as Node runs
  // it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "ESNext.Disposable", "ESNext.Iterator", "DOM"],
    "noUnusedLocals": false,
    "types": ["node"]
  },
  "include": ["*.ts", "generated/**/*.ts"]
}
