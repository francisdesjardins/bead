{
  "name": "@francisdesjardins/bead",
  "version": "0.6.0",
  "private": true,
  "description": "Bead, the binary wire protocol, on the TypeScript side: a WebSocket, an HTTP, a Web Worker and an in-memory transport, each a client and a server, a server's transports joined into one, a client and a server router with the service, session and notification managers, the client and server over them, and a gateway that answers a service's procedures over HTTP and JSON.",
  "license": "Apache-2.0",
  "author": "Francis Desjardins <francis.desjardins@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francisdesjardins/bead.git",
    "directory": "implementations/typescript"
  },
  "type": "module",
  "exports": {
    "./client": "./src/client/client.ts",
    "./http-client": "./src/client/http-client.ts",
    "./http-gateway": "./src/transcoding/http-gateway.ts",
    "./http-server": "./src/server/http-server.ts",
    "./http-transport-client": "./src/transport/client/http-transport-client.ts",
    "./http-transport-server": "./src/transport/server/http-transport-server.ts",
    "./joined-transport-server": "./src/transport/server/joined-transport-server.ts",
    "./memory-transport-client": "./src/transport/client/memory-transport-client.ts",
    "./memory-transport-server": "./src/transport/server/memory-transport-server.ts",
    "./notification-manager": "./src/router/server/notification-manager.ts",
    "./proto": "./src/proto/proto.ts",
    "./router-client": "./src/router/client/router-client.ts",
    "./router-server": "./src/router/server/router-server.ts",
    "./service": "./src/service/service.ts",
    "./service-manager": "./src/router/shared/service-manager.ts",
    "./session-manager": "./src/router/server/session-manager.ts",
    "./server": "./src/server/server.ts",
    "./transcoding": "./src/transcoding/transcoding.ts",
    "./transport-client": "./src/transport/client/transport-client.ts",
    "./transport-server": "./src/transport/server/transport-server.ts",
    "./worker-client": "./src/client/worker-client.ts",
    "./worker-server": "./src/server/worker-server.ts",
    "./worker-transport-client": "./src/transport/client/worker-transport-client.ts",
    "./worker-transport-server": "./src/transport/server/worker-transport-server.ts",
    "./ws-client": "./src/client/ws-client.ts",
    "./ws-server": "./src/server/ws-server.ts",
    "./ws-transport-client": "./src/transport/client/ws-transport-client.ts",
    "./ws-transport-server": "./src/transport/server/ws-transport-server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "comment-budget": "node tools/check-comment-budget.mjs",
    "demo": "node demo/serve.ts",
    "devtools:build": "node devtools/build.ts",
    "playground:build:file": "node demo/playground.ts",
    "docs:examples": "node tools/check-examples.mjs",
    "docs:examples:fix": "node tools/check-examples.mjs --fix",
    "check": "yarn type-check && yarn lint --deny-warnings && yarn lint:cases && yarn format:check && yarn comment-budget && yarn docs:examples && yarn protobuf:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:cases": "node tools/check-oxlint-plugin.mjs",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "playwright test",
    "test:coverage": "c8 playwright test",
    "test:interop": "playwright test src/client/__tests__/interop.test.ts",
    "test:browser": "playwright test --config playwright.browser.config.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:devtools": "playwright test --config playwright.devtools.config.ts",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit && node node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.validations.json",
    "verify:all": "yarn check && yarn test",
    "protobuf:check": "node tools/check-protobuf.mjs",
    "protobuf:generate": "node tools/check-protobuf.mjs --write",
    "validations:check": "node ../../tools/check-validations.mjs typescript",
    "validations:generate": "node ../../tools/check-validations.mjs typescript --write"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@sinonjs/fake-timers": "15.4.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript-7": "npm:typescript@7.0.2",
    "ws": "^8.22.0"
  },
  "dependenciesMeta": {
    "@bufbuild/buf": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.13.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.9"
  },
  "packageManager": "yarn@4.18.1"
}
