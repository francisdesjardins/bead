{
  // The shared strictness is [tsconfig.base.json](./tsconfig.base.json) beside this file.
  //
  // No `jsx`: nothing here renders. `allowImportingTsExtensions` is the demo's: its Packages tab
  // runs the builder's own selection and reading of `beadc.yaml` (`builder/src/model/selection.ts`,
  // `builder/src/config.ts`), whose imports name their `.ts` files, as Node runs beadc. `src/` keeps
  // its imports bare, a consumer's bundler resolving them: `.oxlintrc.json` refuses a `.ts` one
  // there. `resolveJsonModule` is the demo's too: the tab plans its own blueprint, bundled.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2024", "ESNext.Disposable", "ESNext.Iterator", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "browser/**/*",
    "demo/**/*",
    "devtools/**/*",
    "interop/**/*",
    // the fuzz targets, which import nothing of Jazzer.js: type-checked with the code they read,
    // though Jazzer.js is installed apart, by hand (tools/fuzz/package.json)
    "tools/fuzz/*.ts",
    "playwright.browser.config.ts",
    "playwright.config.ts",
    "playwright.demo.config.ts",
    "playwright.devtools.config.ts"
  ],
  // beadc's output for spec/validations.proto: tsconfig.validations.json type-checks it
  "exclude": ["node_modules", "src/proto/__tests__/generated"]
}
