{
  // The shared strictness is [tsconfig.base.json](./tsconfig.base.json) beside this file.
  //
  // No `jsx` and no `allowImportingTsExtensions`: nothing here renders, which is this package's
  // entry rule rather than an omission.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "ESNext.Iterator", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "browser/**/*",
    "demo/**/*",
    "devtools/**/*",
    "interop/**/*",
    // the fuzz targets, which import nothing of Jazzer.js: type-checked with the code they read,
    // though Jazzer.js is installed apart, by hand (tools/fuzz/package.json)
    "tools/fuzz/*.ts",
    "playwright.browser.config.ts",
    "playwright.config.ts",
    "playwright.devtools.config.ts"
  ],
  "exclude": ["node_modules"]
}
