{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // The lint surface is [.oxlintrc.base.json](./.oxlintrc.base.json), and this project adds to it
  // the shape its functions take.
  "extends": ["./.oxlintrc.base.json"],
  // A function here is an arrow bound to a `const`: no `this`, no `arguments`, no `new`, no
  // rebinding, and no hoisting, so a file reads in the order it is written — dependencies, helpers,
  // then what they serve. A `function` stays where only one does what is needed — overload
  // signatures, an assertion function, a generator, a function called with `new` — each behind an
  // `oxlint-disable-next-line` that says which.
  "rules": {
    "func-style": ["error", "expression"],
    "prefer-arrow-callback": "error"
  },
  "overrides": [
    {
      // Bead takes its time from the clock it is given (decision 0011): a timer or a reading of the
      // globals' is one no test clock reaches. What bounds a platform's own close stays on the real
      // clock, each such call disabled where it stands with its reason; the platform's clock itself
      // is `globalThis`, named once, in `clock.ts`.
      "files": ["src/**/*.ts", "interop/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "a timer runs on the clock given: `clock.setTimeout`"
          },
          {
            "name": "clearTimeout",
            "message": "a timer runs on the clock given: `clock.clearTimeout`"
          },
          {
            "name": "setInterval",
            "message": "a timer runs on the clock given: `clock.setInterval`"
          },
          {
            "name": "clearInterval",
            "message": "a timer runs on the clock given: `clock.clearInterval`"
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "the wall clock is the clock given's: `clock.Date.now()`"
          },
          {
            "object": "performance",
            "property": "now",
            "message": "the monotonic reading is the clock given's: `clock.performance.now()`"
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "a timer runs on the clock given: `clock.setTimeout`"
          },
          {
            "object": "globalThis",
            "property": "clearTimeout",
            "message": "a timer runs on the clock given: `clock.clearTimeout`"
          },
          {
            "object": "globalThis",
            "property": "setInterval",
            "message": "a timer runs on the clock given: `clock.setInterval`"
          },
          {
            "object": "globalThis",
            "property": "clearInterval",
            "message": "a timer runs on the clock given: `clock.clearInterval`"
          },
          {
            "object": "AbortSignal",
            "property": "timeout",
            "message": "a signal's timeout is a timer, which runs on the clock given: `clock.setTimeout` and an `AbortController`"
          }
        ]
      }
    },
    {
      // The interop's code is what beadc generates from its blueprint (decision 0022): the files
      // written by hand beside it register their resolvers and call through its server and client,
      // never through a service manager's accessor. The generated folder is outside the pattern.
      // ! An override's options replace an earlier one's for the same rule: the clock's entries
      // above are repeated here, and move with them
      "files": ["interop/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "the wall clock is the clock given's: `clock.Date.now()`"
          },
          {
            "object": "performance",
            "property": "now",
            "message": "the monotonic reading is the clock given's: `clock.performance.now()`"
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "a timer runs on the clock given: `clock.setTimeout`"
          },
          {
            "object": "globalThis",
            "property": "clearTimeout",
            "message": "a timer runs on the clock given: `clock.clearTimeout`"
          },
          {
            "object": "globalThis",
            "property": "setInterval",
            "message": "a timer runs on the clock given: `clock.setInterval`"
          },
          {
            "object": "globalThis",
            "property": "clearInterval",
            "message": "a timer runs on the clock given: `clock.clearInterval`"
          },
          {
            "object": "AbortSignal",
            "property": "timeout",
            "message": "a signal's timeout is a timer, which runs on the clock given: `clock.setTimeout` and an `AbortController`"
          },
          {
            "property": "getRequest",
            "message": "the interop calls through its generated client: `InteropClient`"
          },
          {
            "property": "getRequestResolver",
            "message": "the interop registers through its generated server: `InteropServer.on`"
          },
          {
            "property": "getNotification",
            "message": "the interop subscribes through its generated client: `InteropClient.notifications`"
          },
          {
            "property": "getNotificationResolver",
            "message": "the interop notifies through its generated server: `InteropServer.notify`"
          },
          {
            "property": "getCommand",
            "message": "the interop commands through its generated server: `InteropServer.command`"
          },
          {
            "property": "getCommandResolver",
            "message": "the interop answers a command through its generated client: `InteropClient.on`"
          }
        ]
      }
    },
    {
      // a test may wait on the platform's own timers, or test one: the clock it gives Bead is its
      // own
      "files": ["**/__tests__/**"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      // the one declaration among the sources, which its JSDoc names as the exception
      "files": ["src/transport/shared/thrown-message.ts"],
      "rules": {
        "func-style": "off"
      }
    },
    {
      // the examples' harness wraps a snippet that awaits in a function of its own: the wrapper is
      // the tool's, not the library's
      "files": ["**/scripts/examples/generated/**/*.tsx"],
      "rules": {
        "func-style": "off"
      }
    },
    {
      // the gates, plain Node modules whose functions are declarations
      "files": ["tools/**"],
      "rules": {
        "func-style": "off",
        "prefer-arrow-callback": "off"
      }
    },
    {
      // the gates' CLIs, the commands `check` runs: stdout is their whole output contract
      "files": [
        "tools/check-comment-budget.mjs",
        "tools/check-examples.mjs",
        "tools/check-oxlint-plugin.mjs",
        "tools/check-protobuf.mjs"
      ],
      "rules": {
        "no-console": "off",
        "curly": "off",
        "arrow-body-style": "off"
      }
    }
  ],
  // **Not inherited through `extends`** — not even by a child that declares none — so the list is
  // written out here in full. Measured against oxlint 1.83.0.
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/playwright/.cache/**",
    "**/playwright/.cache-coverage/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/*.d.ts",
    // protoc-gen-es's, committed as it writes it: `tools/check-protobuf.mjs` holds it to its
    // generator
    "**/*_pb.ts",
    // the plugin's cases, refused on purpose: `tools/check-oxlint-plugin.mjs` lints them apart
    "tools/oxlint-plugin.cases.ts",
    ".yarn/**"
  ]
}
