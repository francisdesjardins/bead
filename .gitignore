# What each toolchain writes. Each implementation may keep its own `.gitignore` beside this one;
# implementations/typescript does, for what Yarn writes.

# .NET: build outputs and test results, under every project
bin/
obj/
TestResults/
*.user
.vs/

# TypeScript: dependencies, builds, test and coverage reports
node_modules/
dist/
coverage/
.nyc_output/
playwright-report/
test-results/

# Python: the spec's generators leave their bytecode beside them, and the check its environment
__pycache__/
*.py[cod]
.venv/

# Editors and systems
.idea/
.DS_Store
Thumbs.db
*.log

# beadc's own folder beside a beadc.yaml, the root's among them: what it extracts or writes for a run
.beadc/

# protobuf's conformance runner and protovalidate-es, fetched by their pins, what
# tools/protobuf-conformance.mjs and tools/protovalidate-differential.mjs work in, and the code each
# generates into each side's testee
tools/protobuf-conformance/.runner/
tools/protobuf-conformance/.work/
tools/protovalidate-differential/.oracle/
tools/protovalidate-differential/.work/
implementations/typescript/tools/protobuf-conformance/generated/
implementations/dotnet/tools/Bead.ProtobufConformance/Generated/
implementations/typescript/tools/protovalidate-differential/generated/
implementations/dotnet/tools/Bead.ProtovalidateDifferential/Generated/

# What tools/fuzz.mjs keeps on each machine: each side's corpora, grown from the seeds it writes,
# its findings, the TypeScript side's bundles and its install of Jazzer.js's state, beadc's alike,
# and the C# side's fuzzer and instrumenter, fetched by their pin, with the build they instrument
implementations/typescript/tools/fuzz/corpus/
implementations/typescript/tools/fuzz/findings/
implementations/typescript/tools/fuzz/.build/
implementations/typescript/tools/fuzz/.yarn/
builder/tools/fuzz/corpus/
builder/tools/fuzz/findings/
builder/tools/fuzz/.build/
builder/tools/fuzz/.yarn/
implementations/dotnet/tools/Bead.Fuzz/corpus/
implementations/dotnet/tools/Bead.Fuzz/findings/
implementations/dotnet/tools/Bead.Fuzz/.fuzzer/

# The benches' reports a release keeps, each its machine's, compared with the next release's there
/.bench/

# What this clone keeps for itself and never commits: the working notes and plans of its sessions
.claude/local/

# What a single Claude session leaves behind: its local settings and its worktrees. The rest of
# .claude/ is shared and committed.
.claude/settings.local.json
.claude/worktrees/
