# Everything Yarn writes is derived, except the release, which is the point of vendoring it.
.yarn/*
!.yarn/releases
.pnp.*
node_modules/

# ! the root ignores every dist/: this one is the page the site serves, built and committed
!/dist/

# what deploy.mjs assembles and Wrangler uploads, and what Wrangler keeps for itself
/out/
.wrangler/
